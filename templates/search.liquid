<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18"><div class="shell">
  <form action="{{ routes.search_url }}" method="get" class="form" style="margin-bottom:40px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" style="flex:1 1 240px;background:transparent;border:0;border-bottom:1px solid var(--rule);padding:11px 2px;font:inherit;font-size:18px">
    <button type="submit"><span>{{ 'general.search.submit' | t }}</span></button>
  </form>
  {%- if search.performed -%}
    <p class="eyebrow">{{ 'general.search.results' | t: count: search.results_count }}</p>
    <div class="grid4">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{%- render 'product-card', card_product: item, tone: 'grey' -%}{%- endif -%}{%- endfor -%}</div>
  {%- endif -%}
</div></section>
