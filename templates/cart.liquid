{%- comment -%}
  The bag page. Most people see the drawer instead; this is where the bag link lands
  without JavaScript, and where Shopify sends people back from checkout. Same lines and
  same foot as the drawer (snippets/bag-line, snippets/bag-foot).
{%- endcomment -%}
<section class="pad" data-bg="#EFF0EC" data-fg="#14171A" style="--sec-bg:#EFF0EC;--sec-fg:#14171A;">
  <div class="shell bag-page">
    <h1 class="bag-page-h">Bag</h1>
    {%- if cart.item_count > 0 -%}
      <ul class="bag-lines" role="list">
        {%- for item in cart.items -%}{%- render 'bag-line', item: item -%}{%- endfor -%}
      </ul>
      {%- render 'bag-foot', cart: cart -%}
    {%- else -%}
      <div class="bag-empty">
        <p class="bag-empty-h">Nothing in the bag yet.</p>
        <p>Every piece here is one of one. When it sells, it goes to the Record.</p>
        <a class="bag-link" href="{{ routes.all_products_collection_url }}">See every piece</a>
      </div>
    {%- endif -%}
  </div>
</section>
