<section class="pad" data-bg="#EFF0EC" data-fg="#14171A"><div class="shell" style="max-width:820px">
  <h1 style="font-family:var(--serif);font-weight:200;font-size:clamp(30px,6vw,54px);margin:0 0 30px">Bag</h1>
  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      {%- for item in cart.items -%}
        <div style="display:flex;gap:20px;padding:18px 0;border-bottom:1px solid var(--rule)">
          <div style="flex:0 0 96px">{%- render 'plate', image: item.image, ratio: 1.25, seed: item.product.id, alt: item.title -%}</div>
          <div style="flex:1">
            <div style="font-family:var(--serif);font-size:20px">{{ item.product.vendor | default: item.title }}</div>
            <div style="font-family:var(--serif);font-style:italic;opacity:.7;font-size:14px">{{ item.product.metafields.hikari.piece | default: item.title }}</div>
            <a href="{{ item.url_to_remove }}" style="font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.5;display:inline-block;margin-top:8px">Remove</a>
          </div>
          <div class="price" style="font-size:18px">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
      <div style="display:flex;justify-content:space-between;align-items:baseline;padding:22px 0">
        <span class="eyebrow" style="margin:0">Total</span><span class="price" style="font-size:26px">{{ cart.total_price | money }}</span>
      </div>
      <p style="font-size:12px;opacity:.6;margin:0 0 20px">{{ settings.vat_line }}</p>
      <button class="btn" type="submit" name="checkout">Checkout</button>
    {%- endform -%}
  {%- else -%}
    <p style="font-family:var(--serif);font-style:italic;font-size:22px;opacity:.7">Nothing in the bag yet.</p>
    <p style="margin-top:20px"><a href="{{ routes.all_products_collection_url }}" style="border-bottom:1px solid">See what is here</a></p>
  {%- endif -%}
</div></section>
