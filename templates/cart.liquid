{%- comment -%}
  The bag page. Most people see the drawer instead; this is where the bag link lands
  without JavaScript, and where Shopify sends people back from checkout. Same lines and
  same foot as the drawer (snippets/bag-line, snippets/bag-foot).
{%- endcomment -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell bag-page">
    <h1 class="bag-page-h">{{ 'layout.cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <ul class="bag-lines" role="list">
        {%- for item in cart.items -%}{%- render 'bag-line', item: item -%}{%- endfor -%}
      </ul>
      {%- render 'bag-foot', cart: cart, ctx: 'page' -%}
    {%- else -%}
      <div class="bag-empty">
        <p class="bag-empty-h">{{ 'cart.empty_heading' | t }}</p>
        <p>{{ 'cart.empty_body' | t }}</p>
        <a class="bag-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.see_every_piece' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
