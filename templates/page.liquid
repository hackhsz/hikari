{%- comment -%}
  A page with the handle "creators" gets the creators section (D28) even on the default template:
  the template list in Pages shows only the live theme's templates, so on a preview theme the
  "creators" template cannot be picked yet. page.creators.json does the same once it can.
  A page with the handle "preferences" gets the "What do you collect?" form under its text,
  with an email field, for people on the list who have not answered it yet (CRM).
{%- endcomment -%}
{%- if page.handle == 'creators' -%}
  {% section 'main-creators' %}
{%- else -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18"><div class="shell" style="max-width:68ch">
  <h1 style="font-family:var(--serif);font-weight:200;font-size:clamp(30px,6vw,54px);line-height:1.02;margin:0 0 26px">{{ page.title }}</h1>
  <div class="rte">{{ page.content }}</div>
  {%- if page.handle == 'preferences' -%}{% render 'preferences', form_id: 'prefs-page', ask_email: true %}{%- endif -%}
</div></section>
{%- endif -%}
