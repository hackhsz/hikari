<!doctype html>
{%- comment -%} Arabic reads right to left; every other language here left to right. {%- endcomment -%}
{%- liquid
  assign lang = request.locale.iso_code
  assign dir = 'ltr'
  if lang == 'ar'
    assign dir = 'rtl'
  endif
-%}
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
  {%- comment -%}
    Google Analytics, only with consent (UK GDPR, PECR). gtag queues everything from here on, page
    view and events (assets/track.js), but Google's script loads, and anything leaves the page,
    only once Shopify's cookie banner says analytics is allowed: see the script after
    content_for_header. It used to load at once and set its cookies before anyone had answered.
    Signed-in customers are counted as one person across devices (their customer number only).
  {%- endcomment -%}
  {%- assign ga_id = settings.ga_id | strip -%}
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    gtag('js', new Date());
    gtag('set', 'user_properties', { site_language: {{ request.locale.iso_code | json }}, signed_in: {% if customer %}'yes'{% else %}'no'{% endif %} });
    {%- if ga_id != blank %}
    gtag('config', {{ ga_id | json }}{% if customer %}, { user_id: {{ customer.id | append: '' | json }} }{% endif %});
    {%- endif %}
  </script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <script>document.documentElement.classList.add("js")</script>
  <link rel="canonical" href="{{ canonical_url }}">
  {%- assign brand = settings.brand_name | default: shop.name -%}
  {%- comment -%} Title, description, link previews and structured data: snippets/seo. {%- endcomment -%}
  {%- render 'seo', brand: brand %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- comment -%}
    Arabic, Chinese and Japanese text needs its own faces. Only the language being shown adds
    one to the request, so English loads what it always has. The --serif and --sans stacks they
    extend are at the end of hikari.css.
  {%- endcomment -%}
  {%- liquid
    assign fonts = 'family=Newsreader:ital,opsz,wght@0,6..72,200;0,6..72,300;0,6..72,400;1,6..72,200;1,6..72,300&family=Instrument+Sans:wght@400;500;600'
    case lang
      when 'ar'
        assign fonts = fonts | append: '&family=Noto+Naskh+Arabic:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600'
      when 'zh-CN'
        assign fonts = fonts | append: '&family=Noto+Serif+SC:wght@200;300;400&family=Noto+Sans+SC:wght@400;500;600'
      when 'ja'
        assign fonts = fonts | append: '&family=Noto+Serif+JP:wght@200;300;400&family=Noto+Sans+JP:wght@400;500;600'
    endcase
  -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ fonts }}&display=swap">

  {{ content_for_header }}
  <script>
    /* Consent: Shopify's Customer Privacy API answers once the banner has (or wasn't needed). */
    (function () {
      var ga = {{ ga_id | json }}, clarity = {{ settings.clarity_id | strip | json }}, done = {};
      function add(key, src, then) {
        if (done[key]) return; done[key] = true;
        var s = document.createElement('script'); s.async = true; s.src = src; if (then) s.onload = then; document.head.appendChild(s);
      }
      function apply() {
        var p = window.Shopify && window.Shopify.customerPrivacy; if (!p) return;
        var a = p.analyticsProcessingAllowed(), m = p.marketingAllowed();
        gtag('consent', 'update', { analytics_storage: a ? 'granted' : 'denied', ad_storage: m ? 'granted' : 'denied',
          ad_user_data: m ? 'granted' : 'denied', ad_personalization: m ? 'granted' : 'denied' });
        if (!a) return;
        if (ga) add('ga', 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga));
        if (clarity) {
          window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
          window.clarity('consentv2', { ad_Storage: m ? 'granted' : 'denied', analytics_Storage: 'granted' });
          add('clarity', 'https://www.clarity.ms/tag/' + encodeURIComponent(clarity));
        }
      }
      document.addEventListener('visitorConsentCollected', apply);
      if (window.Shopify && window.Shopify.loadFeatures) window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (err) { if (!err) apply(); });
    })();
  </script>
  {{ 'hikari.css' | asset_url | stylesheet_tag }}
  <script>
    window.HikariRoutes = {
      cart_url: {{ routes.cart_url | json }},
      cart_add_url: {{ routes.cart_add_url | json }},
      cart_change_url: {{ routes.cart_change_url | json }},
      cart_update_url: {{ routes.cart_update_url | json }},
      predictive_search_url: {{ routes.predictive_search_url | json }}
    };
  </script>
  {%- comment -%}
    The words assets/hikari.js writes, from the locale file. The script keeps the English as a
    fallback. A plural keeps every form the language needs, with [n] for the script to fill.
  {%- endcomment -%}
  {%- liquid
    assign forms = 'one,other' | split: ','
    if lang == 'ar'
      assign forms = 'zero,one,two,few,many,other' | split: ','
    endif
    assign plurals = 'collections.pieces,countdown.days,countdown.hours,countdown.minutes' | split: ','
  -%}
  <script>
    window.hikariStrings = {
      addToBag: {{ 'products.product.add_to_bag' | t | json }},
      inBag: {{ 'products.product.in_bag' | t | json }},
      sold: {{ 'products.product.sold_out' | t | json }},
      justSold: {{ 'products.product.just_sold' | t | json }},
      added: {{ 'cart.added' | t | json }},
      already: {{ 'cart.already' | t | json }},
      removed: {{ 'cart.removed' | t | json }},
      copied: {{ 'general.copied' | t | json }},
      opening: {{ 'general.opening' | t | json }},
      goingLive: {{ 'countdown.now' | t | json }},
      inTime: {{ 'countdown.in' | t: time: '[time]' | json }},
      timeSep: {{ 'countdown.separator' | t | json }},
      plurals: {
        {%- for k in plurals -%}
          {%- assign name = k | split: '.' | last %}
        {{ name | json }}: { {% for f in forms %}{% assign fk = k | append: '.' | append: f %}{{ f | json }}: {{ fk | t: count: '[n]' | json }}{% unless forloop.last %}, {% endunless %}{% endfor %} }{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      }
    };
  </script>
  <script src="{{ 'hikari.js' | asset_url }}" defer></script>
  <script src="{{ 'track.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name }}">
  <div id="grain" aria-hidden="true"></div>
  <a class="skip" href="#main">{{ 'general.skip' | t }}</a>

  {% section 'header' %}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'bag-drawer' %}
  {% section 'signup-popup' %}
  {%- render 'dialogs' -%}
</body>
</html>
