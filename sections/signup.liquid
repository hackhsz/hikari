<section id="list" data-bg="#2F5B45" data-fg="#FAF8F3" style="--sec-bg:#2F5B45;--sec-fg:#FAF8F3;">
  <div class="shell pad signup rule-top">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {%- form 'customer', id: 'edition-form', class: 'form' -%}
      <input type="hidden" name="contact[tags]" value="edition">
      <label class="vh" for="edition-email">{{ 'general.email.label' | t }}</label>
      <input id="edition-email" type="email" name="contact[email]" placeholder="{{ 'signup.placeholder' | t }}" autocomplete="email" required>
      <button type="submit"><span>{{ 'signup.join' | t }}</span></button>
      {%- if form.posted_successfully? %}{% assign edition_joined = true %}<p style="flex:1 1 100%;margin:10px 0 0">{{ 'signup.thanks' | t }}</p>{% endif -%}
    {%- endform -%}
    {%- if edition_joined -%}{% render 'preferences', form_id: 'prefs-edition', after: 'edition-form' %}{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Edition sign-up", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "The Edition goes out Thursday, an hour before anyone else sees it." },
  { "type": "text", "id": "body", "label": "Body", "default": "One of one means the best piece is gone first. The list gets it first." }
], "presets": [{ "name": "Edition sign-up" }] }
{% endschema %}
