<section id="list" data-bg="#F4F0E8" data-fg="#1C1B18" style="--sec-bg:#F4F0E8;--sec-fg:#1C1B18;">
  <div class="shell pad signup rule-top">
    {%- assign std_heading = 'signup.heading' | t -%}{%- assign std_body = 'signup.body' | t -%}
    <h2>{{ section.settings.heading | default: std_heading }}</h2>
    <p>{{ section.settings.body | default: std_body }}</p>
    {%- form 'customer', id: 'edition-form', class: 'form' -%}
      <input type="hidden" name="contact[tags]" value="edition">
      <label class="vh" for="edition-email">{{ 'general.email.label' | t }}</label>
      <input id="edition-email" type="email" name="contact[email]" placeholder="{{ 'signup.placeholder' | t }}" autocomplete="email" required>
      <button type="submit"><span>{{ 'signup.join' | t }}</span></button>
      {%- if form.posted_successfully? %}{% assign edition_joined = true %}<p style="flex:1 1 100%;margin:10px 0 0">{{ 'signup.thanks' | t }}</p>{% endif -%}
    {%- endform -%}
    {%- if edition_joined -%}{% render 'preferences', form_id: 'prefs-edition', after: 'edition-form' %}{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Edition sign-up", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty for the standard wording, which is translated into every language. Text here replaces it in English (translate it in Translate & Adapt)." },
  { "type": "text", "id": "body", "label": "Body", "info": "Leave empty for the standard wording, which is translated into every language. Text here replaces it in English (translate it in Translate & Adapt)." }
], "presets": [{ "name": "Edition sign-up" }] }
{% endschema %}
