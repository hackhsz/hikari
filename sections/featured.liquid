{%- comment -%}
  Three pieces after the one in the Alcove. A block without a piece falls back to the next piece in
  stock, then to coming-soon pieces, counted in the same order as the Alcove's fallback. Empty frames
  show only in the theme editor; with no pieces at all the section is left out.
{%- endcomment -%}
{%- capture cards -%}
  {%- assign shown = 0 -%}
  {%- for block in section.blocks limit: 3 -%}
    {%- assign bp = block.settings.product -%}
    {%- unless bp -%}
      {%- assign want = forloop.index | plus: 1 -%}{%- assign n = 0 -%}
      {%- for cp in collections.all.products -%}
        {%- if cp.available -%}
          {%- assign n = n | plus: 1 -%}
          {%- if n == want -%}{%- assign bp = cp -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless bp -%}
        {%- for cp in collections.all.products -%}
          {%- if cp.tags contains 'coming-soon' -%}
            {%- assign n = n | plus: 1 -%}
            {%- if n == want -%}{%- assign bp = cp -%}{%- break -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endunless -%}
    {%- if bp -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- render 'product-card', card_product: bp, tone: 'grey', card_sizes: '50vw' -%}
    {%- elsif request.design_mode -%}
      <a class="card" href="{{ routes.all_products_collection_url }}">
        {%- render 'plate', ratio: 1, fill: true, seed: forloop.index, tone: 'grey', comp: 'single' -%}
        <div class="cinfo"><h3 class="chouse">—</h3></div></a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 or request.design_mode -%}
<section class="pad" data-bg="#F4F0E8" data-fg="#1C1B18" style="--sec-bg:#F4F0E8;--sec-fg:#1C1B18;">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.heading }}</p>
    <div class="featured">{{ cards }}</div>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "This Edition", "max_blocks": 3,
  "settings": [{ "type": "text", "id": "heading", "label": "Eyebrow", "default": "This Edition — three more" }],
  "blocks": [{ "type": "piece", "name": "Piece", "settings": [{ "type": "product", "id": "product", "label": "Piece" }] }],
  "presets": [{ "name": "This Edition", "blocks": [{"type":"piece"},{"type":"piece"},{"type":"piece"}] }] }
{% endschema %}
