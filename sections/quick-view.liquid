{%- comment -%}
  Quick view: a piece in a dialog, without leaving the grid. Never placed on a template.
  assets/hikari.js asks for it by name, in the product's own context:
    /products/{handle}?section_id=quick-view
  and puts it into the #qv dialog (snippets/dialogs). Add to bag inside it is the ordinary
  product form, so the bag script handles it like any other.

  Coming soon and sold pieces point to their page, where the "Tell me" forms are.
{%- endcomment -%}
{%- assign p = product -%}
{%- if p -%}
{%- capture status -%}{%- render 'status', p: p -%}{%- endcapture -%}
{%- assign piece = p.metafields.hikari.piece | default: p.title -%}
<div class="qv" data-qv>
  <a class="qv-media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
    {%- render 'plate', image: p.featured_image, ratio: 1.25, seed: p.id, tone: 'light',
        comp: 'single', alt: p.title, badge: status, width: 1000 -%}
  </a>
  <div class="qv-info">
    <h2 class="qv-house" id="qv-title">{{ p.vendor | default: p.title }}</h2>
    <p class="qv-piece">{{ piece }}</p>
    <span class="price qv-price">{% if status == 'sold' %}{{ 'products.product.sold_out' | t }}{% else %}{%- render 'price', p: p -%}{% endif %}</span>

    {%- case status -%}
      {%- when 'presale' -%}
        <p class="pdp-status">{{ 'products.product.pre_sale_note' | t: note: settings.presale_note }}</p>
        {%- form 'product', p -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <input type="hidden" name="properties[Pre-sale]" value="{{ settings.presale_note | escape }}">
          {%- assign pre_order = 'products.product.pre_order' | t -%}
          <button class="btn" type="submit" data-label="{{ pre_order }}">{{ pre_order }}</button>
        {%- endform -%}
      {%- when 'soon' -%}
        {%- capture release_at -%}{%- render 'release', p: p -%}{%- endcapture -%}
        <p class="pdp-status">{{ 'products.product.goes_live' | t: release: release_at }}</p>
        <a class="btn" href="{{ p.url }}">{{ 'products.notify.release_heading' | t }}</a>
      {%- when 'sold' -%}
        <p class="pdp-status">{{ 'products.product.kept_on_record' | t }}</p>
        <a class="btn" href="{{ p.url }}">{{ 'products.quick_view.similar' | t }}</a>
      {%- else -%}
        {%- form 'product', p -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <button class="btn" type="submit">{{ 'products.product.add_to_bag' | t }}</button>
        {%- endform -%}
    {%- endcase -%}

    <table class="spec">
      {%- if p.metafields.hikari.grade -%}<tr><th>{{ 'products.spec.condition' | t }}</th><td>{{ 'products.spec.grade' | t: grade: p.metafields.hikari.grade }}</td></tr>{%- endif -%}
      {%- if p.metafields.hikari.measurements -%}<tr><th>{{ 'products.spec.measurements' | t }}</th><td>{{ p.metafields.hikari.measurements }}</td></tr>{%- endif -%}
      {%- if p.metafields.hikari.era -%}<tr><th>{{ 'products.spec.era' | t }}</th><td>{{ p.metafields.hikari.era }}</td></tr>{%- endif -%}
      <tr><th>{{ 'products.spec.availability' | t }}</th><td>{{ 'products.product.one_of_one' | t }}</td></tr>
    </table>
    <a class="hero-link" href="{{ p.url }}">
      {% if p.metafields.hikari.spin.value.size > 1 %}{{ 'products.quick_view.details_spin' | t }}{% else %}{{ 'products.quick_view.details' | t }}{% endif %}
    </a>
  </div>
</div>
{%- endif -%}
{% schema %}{ "name": "Quick view", "settings": [] }{% endschema %}
