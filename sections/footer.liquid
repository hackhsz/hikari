<footer data-bg="#EFEAE0" data-fg="#1C1B18" style="--sec-bg:#EFEAE0;--sec-fg:#1C1B18;">
  {%- comment -%} The trust lines aren't repeated here (owner, 2026-11-04: they took room and weren't
      clear in the footer): they sit by the price on every piece, in the bag, and on the Questions page. {%- endcomment -%}
  <div class="shell pad rule-top">
    {%- comment -%} Menu columns only when the footer has menus (theme editor → Footer): an empty row kept its margin. {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
    <div class="fcols">
      {%- for block in section.blocks -%}
        <div><h4>{{ block.settings.title }}</h4>
          {%- for link in linklists[block.settings.menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
    <div class="foot-social">
      {%- render 'social' -%}
      {%- if pages.creators.id -%}<a class="hero-link" href="{{ pages.creators.url }}">{{ 'layout.footer.creators' | t }}</a>{%- endif -%}
      {%- comment -%} The Questions page (sections/main-guide), on the language's own root. {%- endcomment -%}
      {%- if pages.questions.id -%}<a class="hero-link" href="{{ routes.root_url | append: '/pages/questions' | replace: '//', '/' }}">{{ 'guide.eyebrow' | t }}</a>{%- endif -%}
      {%- comment -%} The guides (sections/main-blog), once there is one to read. {%- endcomment -%}
      {%- if blogs.guides.articles_count > 0 -%}<a class="hero-link" href="{{ routes.root_url | append: '/blogs/guides' | replace: '//', '/' }}">{{ 'blog.title' | t }}</a>{%- endif -%}
      {%- comment -%} Reopens Shopify's cookie banner so a choice can be changed as easily as it was made
          (UK GDPR/PECR). hikari.js shows it only where the banner is loaded. {%- endcomment -%}
      <button type="button" class="hero-link foot-cookies" data-cookie-prefs hidden>{{ 'layout.footer.cookies' | t }}</button>
      {%- render 'language-switcher', id: 'lang-foot' -%}
    </div>
    <div style="margin-top:clamp(40px,7vw,64px)">{%- render 'lockup', height: 'clamp(84px, 16vw, 120px)' -%}</div>
    {%- comment -%} Each part is a theme setting (Legal) and shows only when it is filled in; all are empty for now. {%- endcomment -%}
    {%- assign brand = settings.brand_name | default: shop.name -%}
    {%- capture legal -%}
      {{ settings.legal_disclaimer | replace: '[brand]', brand }}
      {% if settings.company_name != blank %} {{ settings.company_name }}{% if settings.company_number != blank %}{{ 'layout.footer.registered' | t: number: settings.company_number }}{% endif %}{% if settings.company_address != blank %}, {{ settings.company_address }}{% endif %}.{% endif %}
      {{ settings.vat_line }}
    {%- endcapture -%}
    {%- assign legal = legal | strip -%}
    {%- if legal != blank -%}<p class="legal">{{ legal }}</p>{%- endif -%}
  </div>
</footer>
{% schema %}
{ "name": "Footer",
  "blocks": [{ "type": "column", "name": "Column", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "House" },
    { "type": "link_list", "id": "menu", "label": "Menu" }]}] }
{% endschema %}
