{%- comment -%}
  One line above the masthead, from theme settings → Announcement. It scrolls away; the
  masthead stays. The section wrapper is display: contents (hikari.css) so that position: sticky
  measures against the page, not against Shopify's wrapper div, which is only as tall as the header.
{%- endcomment -%}
{%- if settings.announcement != blank -%}
  <p class="announce">{{ settings.announcement }}</p>
{%- endif -%}
<header class="mast">
  <div class="inner">
    <a href="{{ routes.root_url }}" aria-label="{{ settings.brand_name }}, home">
      {%- render 'lockup', scale: 'body', size: '19px' -%}
    </a>
    <nav aria-label="Main">
      {%- for link in linklists.main-menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </nav>
    <div class="mast-r">
      {%- comment -%} Phones hide the nav, so they get a menu sheet. Without JavaScript it falls back to the catalogue. {%- endcomment -%}
      <a class="menu-btn" href="{{ routes.all_products_collection_url }}" data-sheet-open="menu" aria-controls="menu" aria-expanded="false">Menu</a>
      <a class="bag-btn" href="{{ routes.cart_url }}" data-sheet-open="bag" aria-controls="bag" aria-expanded="false">Bag (<span data-bag-count>{{ cart.item_count }}</span>)</a>
    </div>
  </div>
</header>

{%- comment -%} Outside .mast on purpose: the masthead is a sticky band with its own stacking, and the sheet must cover it. {%- endcomment -%}
<div class="sheet sheet--left" id="menu" data-sheet aria-hidden="true" inert>
  <div class="sheet-scrim" data-sheet-close></div>
  <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="menu-title" tabindex="-1">
    <div class="sheet-head">
      <h2 class="sheet-title" id="menu-title">Menu</h2>
      <button type="button" class="sheet-x" data-sheet-close>Close</button>
    </div>
    <nav class="menu-links" aria-label="Main">
      {%- for link in linklists.main-menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      <a href="{{ routes.cart_url }}" data-sheet-open="bag" aria-controls="bag">Bag (<span data-bag-count>{{ cart.item_count }}</span>)</a>
    </nav>
    <div class="menu-foot">
      {%- render 'social', label: 'Follow us' -%}
      {%- render 'lockup', scale: 'hero', size: '22px' -%}
    </div>
  </div>
</div>

<script>
  document.documentElement.dataset.scrollColour = "{{ settings.scroll_colour }}";
  document.documentElement.style.setProperty('--grain', {{ settings.grain_opacity | divided_by: 100.0 }});
  {% if settings.grain_animate %}document.body.classList.add('grain-on');{% endif %}
</script>
{% schema %}{ "name": "Header", "settings": [] }{% endschema %}
