{%- comment -%}
  Brand as a first-class navigation axis (1-shop/04-site-ia.md). A brand name is metadata, never
  identity: plain text in our own typeface, no logos.

  Style "Tiles" (the home page, Shop by brand): one square photograph per house, the same size as the
  category tiles above it (owner, 2026-11-04: square like the other pictures, not wide), from a piece
  of that house (snippets/pick) that New in and the category tiles do not already show. Each house
  is a collection on the house template.

  Style "Names": the houses as display type. With blocks, each house links to its URL, or when
  that is left empty, to its house page (snippets/house-url). With no blocks, as on the house
  template, it lists every collection on the house template by itself, and marks the one being viewed.
{%- endcomment -%}
{%- if section.settings.style == 'tiles' -%}
  {%- liquid
    assign cat_tags = 'necklaces,earrings,bracelets,rings,brooches,sunglasses' | split: ','
    capture avoid
      render 'newest-handles'
    endcapture
    assign avoid = avoid | strip
    for t in cat_tags
      if collections.all.all_tags contains t
        capture h
          render 'pick', tag: t, avoid: avoid
        endcapture
        assign avoid = avoid | append: h | strip | append: ','
      endif
    endfor
  -%}
  <section class="pad-s" id="houses" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
    <div class="shell">
      <div class="sec-head"><div><h2 class="sec-h">{{ section.settings.heading }}</h2></div></div>
      <div class="house-tiles">
        {%- for c in collections -%}
          {%- if c.template_suffix != 'house' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign name = c.metafields.hikari.house.value | default: c.products.first.vendor | default: c.title
            capture h
              render 'pick', list: c.products, avoid: avoid
            endcapture
            assign h = h | strip
            assign pick = all_products[h]
            assign avoid = avoid | append: h | append: ','
          -%}
          <a class="cat-tile house-tile" href="{{ c.url }}">
            {%- render 'plate', image: pick.featured_image, ratio: 1, fill: true, sizes: '(max-width: 600px) 50vw, (max-width: 900px) 33vw, 200px', seed: forloop.index, tone: 'light', comp: 'single', alt: '' -%}
            <span class="ct-name">{{ name }}</span>
            <span class="ct-n">{{ 'collections.pieces' | t: count: c.products_count }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- else -%}
<section class="pad" id="houses" data-bg="#EFEAE0" data-fg="#1C1B18" style="--sec-bg:#EFEAE0;--sec-fg:#1C1B18;">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.heading }}</p>
    <div class="houses">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.url != blank -%}
            {%- assign url = block.settings.url -%}
          {%- else -%}
            {%- capture url -%}{%- render 'house-url', name: block.settings.name -%}{%- endcapture -%}
          {%- endif -%}
          <a href="{{ url }}" {{ block.shopify_attributes }}>{{ block.settings.name }}</a>
          {%- unless forloop.last %}<span class="sep">·</span>{% endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign first = true -%}
        {%- for c in collections -%}
          {%- if c.template_suffix != 'house' -%}{%- continue -%}{%- endif -%}
          {%- assign name = c.metafields.hikari.house.value | default: c.products.first.vendor | default: c.title -%}
          {%- unless first %}<span class="sep">·</span>{% endunless -%}
          {%- assign first = false -%}
          <a href="{{ c.url }}"{% if collection and c.id == collection.id %} aria-current="page"{% endif %}>{{ name }}</a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "Shop by house",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by brand" },
    { "type": "select", "id": "style", "label": "Style", "default": "names",
      "options": [
        { "value": "tiles", "label": "Tiles, a photograph per house" },
        { "value": "names", "label": "Names" }
      ] }
  ],
  "blocks": [{ "type": "house", "name": "House", "settings": [
    { "type": "text", "id": "name", "label": "House", "default": "Christian Dior" },
    { "type": "url", "id": "url", "label": "Link", "info": "Names style only. Leave empty to link to the house page, /collections/vintage-[house]-jewellery." }]}],
  "presets": [{ "name": "Shop by house" }] }
{% endschema %}
