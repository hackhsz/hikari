{%- comment -%}
  A guide: an article in the blog "Guides" (2026-11-04). Laid out like the Questions page
  (sections/main-guide): the house header (the blog's name, the title in the size article titles
  always had here, the summary, the date), the photograph, then the text in the essay's measure.
  After the text, the pieces the guide links to, as cards, and the other guides.

  The text is written in Shopify (Online Store → Blog posts) with plain links to /products/… and
  /collections/…; here those links get the shop's underline (spec-link) and the language's own
  root (/ja/products/…), so a reader stays in their language. Search data (BlogPosting,
  BreadcrumbList) is in snippets/seo.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url | append: '/' | replace: '//', '/'
  assign body = article.content | replace: '<a href=', '<a class="spec-link" href='
  if root != '/'
    assign pre = 'href="' | append: root
    assign body = body | replace: 'href="/', pre
  endif
  assign handles = ','
  assign parts = article.content | split: '/products/'
  for part in parts offset: 1
    assign h = part | split: '"' | first | split: '?' | first | split: '#' | first
    assign hk = ',' | append: h | append: ','
    unless handles contains hk
      assign handles = handles | append: h | append: ','
    endunless
  endfor
  assign handles = handles | split: ','
-%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell">
    <header class="house-head">
      <p class="eyebrow"><a href="{{ blog.url }}">{{ blog.title }}</a></p>
      <h1 class="house-h guide-h">{{ article.title }}</h1>
      {%- if article.excerpt != blank -%}<p class="house-lede">{{ article.excerpt | strip_html | strip }}</p>{%- endif -%}
      <p class="house-fine">{{ article.published_at | time_tag: format: 'date' }}</p>
    </header>
    {%- if article.image -%}
      <figure class="guide-plate">
        {%- render 'plate', image: article.image, ratio: 1, fill: true, first: true, alt: article.image.alt, sizes: '(max-width: 600px) 100vw, 560px', width: 1200 -%}
      </figure>
    {%- endif -%}
    <div class="house-essay"><div class="rte">{{ body }}</div></div>
  </div>
</section>
{%- capture cards -%}
  {%- assign shown = 0 -%}
  {%- for h in handles -%}
    {%- assign q = all_products[h] -%}
    {%- if q.id == blank -%}{%- continue -%}{%- endif -%}
    {%- if shown >= 8 -%}{%- break -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    {%- render 'product-card', card_product: q, tone: 'grey' -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="pad" data-bg="#EFEAE0" data-fg="#1C1B18" style="--sec-bg:#EFEAE0;--sec-fg:#1C1B18;">
  <div class="shell">
    <div class="more-head"><h2 class="eyebrow">{{ 'blog.pieces' | t }}</h2></div>
    <div class="grid4">{{ cards }}</div>
  </div>
</section>
{%- endif -%}
{%- if blog.articles_count > 1 -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell">
    <div class="more-head">
      <h2 class="eyebrow">{{ 'blog.more' | t }}</h2>
      <a class="hero-link" href="{{ blog.url }}">{{ 'blog.all' | t }}</a>
    </div>
    <ul class="guide-list">
      {%- for a in blog.articles limit: 4 -%}
        {%- if a.id == article.id -%}{%- continue -%}{%- endif -%}
        <li><a href="{{ a.url }}"><span class="guide-list-h">{{ a.title }}</span>
          {%- if a.excerpt != blank -%}<span class="guide-list-p">{{ a.excerpt | strip_html | strip }}</span>{%- endif -%}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "Guide", "settings": [] }
{% endschema %}
