<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell story">
    <div class="art">{%- render 'plate', image: section.settings.image, ratio: 0.80, seed: 5,
        tone: 'light', comp: 'single', stamp: section.settings.stamp -%}</div>
    <div class="txt">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div>{{ section.settings.body }}</div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Our story", "settings": [
  { "type": "image_picker", "id": "image", "label": "Plate" },
  { "type": "text", "id": "stamp", "label": "Stamp", "default": "Plate 05 · Tokyo, March" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Karineko" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "The beauty of finding something rare." },
  { "type": "richtext", "id": "body", "label": "Body",
    "default": "<p>Karineko is a small, independent shop in London.</p><p>We find our pieces in person and at a few trusted auctions in Japan, and keep only those with something to say. Each one is checked by hand, for authenticity and condition, before it comes to you.</p><p>Luxury, we think, should feel personal, not out of reach.</p><p><em>A past worth keeping.</em></p>" }
], "presets": [{ "name": "Our story" }] }
{% endschema %}
