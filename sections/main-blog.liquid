{%- comment -%}
  The guides (the blog "Guides", 2026-11-04): the house header, then each guide with its
  photograph, title, summary and date, newest first. The guide itself is sections/main-article.
{%- endcomment -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell">
    <header class="house-head">
      <h1 class="house-h">{{ 'blog.title' | t }}</h1>
      <p class="house-lede">{{ 'blog.lede' | t }}</p>
    </header>
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size == 0 -%}
        <p class="house-lede">{{ 'blog.empty' | t }}</p>
      {%- else -%}
        <ul class="guide-index">
          {%- for a in blog.articles -%}
            <li>
              <a href="{{ a.url }}">
                {%- if a.image -%}{%- render 'plate', image: a.image, ratio: 0.75, fill: true, first: forloop.first, alt: '', sizes: '(max-width: 600px) 100vw, 360px' -%}{%- endif -%}
                <span class="guide-list-h">{{ a.title }}</span>
                {%- if a.excerpt != blank -%}<span class="guide-list-p">{{ a.excerpt | strip_html | strip }}</span>{%- endif -%}
                <span class="house-fine">{{ a.published_at | time_tag: format: 'date' }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}<p class="house-fine">{{ paginate | default_pagination }}</p>{%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Guides", "settings": [] }
{% endschema %}
