{%- comment -%}
  Divisions (owner, 2026-11-20: "we want big division and each division comes with animation ... each big
  part should be a section: available to order, now reduced, new in; shop by category and shop by brand can
  be one"). Nothing of its own to show: on the home page it gathers the parts it names into divisions,
  each filling the screen under the masthead with its contents in the middle, and each comes in once as it
  arrives (heading, then the pieces one after another, then its link, then its scroll cue).

  Parts are named by their element ids (or the end of them, for sections Shopify numbers: shelf-sale),
  divisions split by "|", parts of one division joined by "+". A part that isn't on the page is skipped.

  A scroll cue at the foot of every division (owner, 2026-11-20: "have the scroll button there, once
  only", then "every division"): it comes in last, takes you to whatever follows, and once the division
  has been gone past it doesn't come back.

  The green division (the one that starts at Shop by category, which has data-rise): it arrives in the
  in-between green with a clean edge, rises to the top under the masthead and holds there while the page
  keeps going for a while ("hold"), deepening to full green as it does (the colour is set by
  sections/shop-categories from --pin and the hold, read off this division); its cue sits at the foot of
  the screen through the hold.

  Pages (owner, 2026-11-20: "划一下，一个上来，划一下，一个上来，不要连续"): the home page snaps from part to
  part, one swipe one part: the film, the words under it (a division of their own here), each division,
  and the green one twice (arriving, then deepened at the end of its hold). A part a little too tall for
  the screen brings its pieces in a little to fit; one that still doesn't fit (a 2 x 2 shelf on a phone)
  takes two stops, its top and its foot. What follows (the story, the archive, the signup, the footer)
  stops the same way, at each part's top and, when it is taller than the screen, at its foot. The stops are page marks the script adds (see assets/hikari.css).

  Phones (owner, 2026-11-22): the green part is full green with no hold ("get rid of the transition color
  page"); the words under the film are the top of the New in page rather than a near-empty page of their
  own, which starts once the film has gone entirely, so none of it shows behind the masthead ("i dont like
  overflow of the top photo from the top ... combined with the new in"); and the paging is the page's own
  glide rather than the browser's snap ("for mobile page motion, can we smooth that a bit"): the page
  follows the finger, and on letting go glides on to the next stop (or back, after a small nudge), picking
  up the finger's speed and settling gently. A part taller than the screen has a stop about every screen.

  Reduced motion: divisions, pages and cues, but no entrances, no hold and no glide. Without JavaScript, or in the theme
  editor (which needs the sections where it put them), the page is as it was.
{%- endcomment -%}
{%- unless request.design_mode -%}
<a class="division-cue" href="#" hidden><span class="film-cue-word">{{ 'home.scroll_cue' | t }}</span><svg class="film-cue-arrow" viewBox="0 0 34 18" aria-hidden="true"><path d="M2 2l15 14L32 2"/></svg></a>
<script>
  (function (cue) {
    var GROUPS = {{ section.settings.groups | default: '' | json }}, HOLD = {{ section.settings.hold | default: 60 }};
    var still = false, phone = false;
    try { still = matchMedia('(prefers-reduced-motion: reduce)').matches; phone = matchMedia('(max-width: 749px)').matches; } catch (e) {}
    var touch = 'ontouchstart' in window || navigator.maxTouchPoints > 0, glider = null;
    var root = document.documentElement, divs = [], pages = [], tail = [], p = 0, probe = null, seen = '';
    /* a numbered part's own section (it carries the colours) before Shopify's wrapper, whose id ends the same way */
    function find(id) { return id && (document.getElementById(id) || document.querySelector('[data-bg][id$="__' + id + '"]') || document.querySelector('[id$="__' + id + '"]')); }
    /* the masthead (and the delivery line under it): divisions fill the screen below it, the green one holds under it */
    function pin() {
      var m = document.querySelector('.mast'), ma = document.querySelector('.mast-announce'), h = document.querySelector('.division--hold');
      p = (m ? m.offsetHeight : 0) + (ma && ma.offsetParent ? ma.offsetHeight : 0);
      root.style.setProperty('--pin', p + 'px');
      if (h) h.style.setProperty('--pin', p + 'px');
    }
    function after(d) {
      for (var n = d.nextElementSibling; n; n = n.nextElementSibling) if (n.offsetHeight && n.tagName !== 'SCRIPT') return n;
      return null;
    }
    function mark(cls) { var m = document.createElement('div'); m.className = cls; m.setAttribute('aria-hidden', 'true'); return m; }
    function build() {
      GROUPS.split('|').forEach(function (g) {
        var parts = g.split('+').map(function (s) { return find(s.trim()); }).filter(Boolean);
        if (!parts.length) return;
        var first = parts[0], wraps = parts.map(function (p) { return p.closest('.shopify-section') || p; });
        var d = document.createElement('div');
        d.className = 'division'; d.id = 'division-' + (divs.length + 1);
        if (first.dataset.bg) { d.setAttribute('data-bg', first.dataset.bg); d.style.setProperty('--sec-bg', first.dataset.bg); d.style.setProperty('--sec-fg', first.dataset.fg || ''); }
        wraps[0].parentNode.insertBefore(d, wraps[0]);
        var box = d;
        if (first.hasAttribute('data-rise') && !still && !phone) {
          d.classList.add('division--hold'); d.style.setProperty('--hold', HOLD + 'vh');
          box = document.createElement('div'); box.className = 'division-panel'; d.appendChild(box);
          var space = document.createElement('div'); space.className = 'division-space'; space.setAttribute('aria-hidden', 'true'); d.appendChild(space);
        }
        wraps.forEach(function (w) { box.appendChild(w); });
        divs.push(d);
      });
      if (!divs.length) return;
      /* the words under the film: a division of their own, before the others; on a phone, the top of the first */
      var lead = document.getElementById('after-film');
      if (lead && phone) {
        divs[0].insertBefore(lead, divs[0].firstChild);
        divs[0].classList.add('division--words');
        pages = divs.slice();
      } else {
        pages = (lead ? [lead] : []).concat(divs);
        if (lead) lead.classList.add('division', 'division--lead');
      }
      /* the cues, once every division is in place: each takes you to the next part */
      if (cue) pages.forEach(function (d, i) {
        var n = pages[i + 1] || after(d);
        if (!n) return;
        var c = cue.cloneNode(true);
        c.hidden = false;
        if (n.id) c.href = '#' + n.id;
        (d.querySelector('.division-panel') || d).appendChild(c);
        c.addEventListener('click', function (e) {
          e.preventDefault();
          d.classList.add('cue-done');
          if (glider) glider.next();
          else scrollTo({ top: n.getBoundingClientRect().top + scrollY - p, behavior: still ? 'auto' : 'smooth' });
        });
      });
      /* the stops: the film, each division's top (and foot when it is taller than the screen), the end of the
         green one's hold; then each part that follows */
      var film = document.querySelector('.film-hold');
      if (film) film.insertBefore(mark('page-mark'), film.firstChild);
      pages.forEach(function (d) {
        d.insertBefore(mark('page-mark'), d.firstChild);
        if (!d.classList.contains('division--hold')) d.appendChild(mark('page-end'));
      });
      var last = divs[divs.length - 1], foot = document.querySelector('footer[data-bg]');
      for (var n = last.nextElementSibling; n; n = n.nextElementSibling) if (n.offsetHeight && n.tagName !== 'SCRIPT') tail.push(n);
      foot = foot && (foot.closest('.shopify-section') || foot);
      if (foot) tail.push(foot);
      tail.forEach(function (t) { t.insertBefore(mark('page-mark'), t.firstChild); t.appendChild(mark('page-end')); });
      probe = document.createElement('div');
      probe.style.cssText = 'position:fixed;top:0;left:0;width:0;height:100vh;height:100svh;visibility:hidden;pointer-events:none';
      document.body.appendChild(probe);
      root.classList.add('has-divisions', 'has-pages');
      pin();
      fit();
      if (!still && 'IntersectionObserver' in window) entrances(pages);
      watch();
      if (phone && touch && !still) glide();
    }
    /* one part to a screen: where a part is a little taller than the screen under the masthead, its pieces come
       in a little (--fit: the shelves to no less than 70%, the green part's round tiles 60%) until it fits;
       where even that is not enough (a 2 x 2 shelf on a phone) it keeps its size and takes two stops, its top
       and its foot */
    function fit() {
      var avail = (probe ? probe.offsetHeight : innerHeight) - p, key = innerWidth + 'x' + avail;
      if (key === seen) return;
      seen = key;
      pages.forEach(function (d) {
        var box = d.querySelector('.division-panel') || d, cs = getComputedStyle(box);
        var pad = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
        /* the phone's first page starts at the top of the screen, with room for the masthead in it */
        var room = avail + (d.classList.contains('division--words') ? p : 0);
        var need = function () { var h = pad; [].forEach.call(box.children, function (c) { if (!/page-(mark|end)/.test(c.className)) h += c.offsetHeight; }); return h; };
        var size = function (f) { if (f >= 1) box.style.removeProperty('--fit'); else box.style.setProperty('--fit', f.toFixed(3)); };
        size(1);
        var tall = need() > room + 2;
        if (tall && box.querySelector('.grid4, .icon-tiles, .cat-tiles, .house-tiles')) {
          var lo = box.querySelector('.icon-tiles--ring') ? 0.6 : 0.7, hi = 1;
          size(lo);
          if (need() <= room + 2) {
            for (var k = 0; k < 7; k++) { var f = (lo + hi) / 2; size(f); if (need() <= room + 2) lo = f; else hi = f; }
            size(lo); tall = false;
          } else size(1);
        }
        d.classList.toggle('is-tall', tall);
      });
      /* what follows the divisions: a stop at each part's top, and at its foot when it is taller than the screen */
      tail.forEach(function (t) { t.classList.toggle('is-tall', t.offsetHeight > avail + 2); });
    }
    /* each division comes in once: the heading, then the pieces one after another, then the link, then the cue */
    function entrances(divs) {
      var o = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          var d = e.target; o.unobserve(d);
          d.classList.remove('dv-wait');
          setTimeout(function () { [].forEach.call(d.querySelectorAll('.dv-a'), function (a) { a.classList.remove('dv-a'); a.style.removeProperty('--d'); }); }, 2600);
        });
      }, { rootMargin: '0px 0px -18% 0px' });
      divs.forEach(function (d) {
        var n = 0, mark = function (el, ms) { el.classList.add('dv-a'); el.style.setProperty('--d', ms + 'ms'); };
        /* the words under the film: line by line, then the link */
        [].forEach.call(d.querySelectorAll(':is(.division--lead, .division--words > .hero-txt) :is(.hero-b > *, .hero-ctas)'), function (l, i) { mark(l, i * 140); n = 1; });
        [].forEach.call(d.querySelectorAll('section'), function (sec) {
          [].forEach.call(sec.querySelectorAll('.sec-head, .ne-head'), function (h) { mark(h, n * 120); });
          [].forEach.call(sec.querySelectorAll('.grid4 > *, .icon-tiles > *, .cat-tiles > *, .house-tiles > *'), function (c, i) { mark(c, n * 120 + 160 + Math.min(i, 8) * 90); });
          [].forEach.call(sec.querySelectorAll('.sec-more, .ne-foot'), function (f) { mark(f, n * 120 + 700); });
          n++;
        });
        var c = d.querySelector('.division-cue');
        if (c) mark(c, (n - 1) * 120 + 1000);
        if (d.getBoundingClientRect().top > innerHeight * 0.82) { d.classList.add('dv-wait'); o.observe(d); }
      });
    }
    /* once only: a division's cue goes for good once the division has been gone past */
    function watch() {
      var ticking = false, later = 0;
      function tick() {
        ticking = false;
        pages.forEach(function (d) {
          if (!d.classList.contains('cue-done') && d.getBoundingClientRect().bottom <= innerHeight * 0.55) d.classList.add('cue-done');
        });
      }
      function again() { pin(); fit(); tick(); }
      addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
      addEventListener('resize', function () { clearTimeout(later); later = setTimeout(again, 150); }, { passive: true });
      addEventListener('load', function () { seen = ''; again(); });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { seen = ''; again(); });
      tick();
    }
    /* phones: the page's own glide from stop to stop (see the top). The stops: the film; each part's top (the
       first, once the film has gone entirely); and in a part taller than the screen, about one a screen down
       to its foot. One swipe, one stop on or back, wherever the finger let go. */
    function glide() {
      var x0 = 0, y0 = 0, s0 = 0, mode = 0, track = [], anim = 0, cue = document.querySelector('.film-cue');
      root.classList.add('is-glide');
      function stops() {
        var vh = innerHeight, room = vh - p, y = scrollY, max = root.scrollHeight - vh, out = [0];
        pages.concat(tail).forEach(function (el) {
          var r = el.getBoundingClientRect(), top = r.top + y, h = r.height;
          if (!h) return;
          if (el.classList.contains('division--words')) { top += p; h -= p; }
          var a = top - p, b = top + h - vh;
          out.push(a);
          if (b > a + 2) { var n = Math.ceil((b - a) / (room * 0.9)); for (var i = 1; i <= n; i++) out.push(a + (b - a) * i / n); }
        });
        out = out.map(function (s) { return Math.round(Math.max(0, Math.min(max, s))); }).sort(function (a, b) { return a - b; });
        return out.filter(function (s, i) { return !i || s - out[i - 1] > 24; });
      }
      /* from here to y: it sets off at the speed the finger let go with (v, px/ms down the page) and settles
         gently (a cubic with that speed at the start and none at the end); from still, it eases in and out */
      function to(y, v) {
        cancelAnimationFrame(anim); anim = 0;
        var a = scrollY, d = y - a;
        if (Math.abs(d) < 1) return;
        var dur = Math.max(520, Math.min(900, 440 + Math.abs(d) * 0.5)), c = v && v * d > 0 ? Math.min(3, v * dur / d) : 0, t0 = 0;
        function step(now) {
          if (!t0) t0 = now;
          var k = Math.min(1, (now - t0) / dur);
          scrollTo(0, a + d * (((c - 2) * k + 3 - 2 * c) * k * k + c * k));
          anim = k < 1 ? requestAnimationFrame(step) : 0;
        }
        anim = requestAnimationFrame(step);
      }
      function next() {
        var y = scrollY, list = stops();
        for (var i = 0; i < list.length; i++) if (list[i] > y + 8) return to(list[i], 0);
      }
      function ours(t) { return t && t.closest && t.closest('#main, footer') && !t.closest('dialog, iframe'); }
      addEventListener('touchstart', function (e) {
        mode = e.touches.length === 1 && ours(e.target) ? 0 : 2;
        if (mode) return;
        cancelAnimationFrame(anim); anim = 0;
        x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; s0 = scrollY; track = [[e.timeStamp, y0]];
      }, { passive: true });
      addEventListener('touchmove', function (e) {
        if (mode === 2) return;
        if (e.touches.length > 1) { mode = 2; return; }
        var t = e.touches[0], dy = t.clientY - y0;
        if (!mode) {
          /* a tap stays a tap; pulling down at the very top is the browser's own (refresh) */
          if (Math.abs(dy) < 6 && Math.abs(t.clientX - x0) < 6) return;
          if (s0 <= 0 && dy > 0) { mode = 2; return; }
          mode = 1;
        }
        if (e.cancelable) e.preventDefault();
        scrollTo(0, s0 - dy);
        track.push([e.timeStamp, t.clientY]);
        if (track.length > 8) track.shift();
      }, { passive: false });
      function end(e) {
        if (mode !== 1) { mode = 0; return; }
        mode = 0;
        var last = track[track.length - 1], i = 0, v = 0;
        while (i < track.length - 2 && last[0] - track[i][0] > 100) i++;
        if (e.timeStamp - last[0] < 90 && last[0] > track[i][0]) v = -(last[1] - track[i][1]) / (last[0] - track[i][0]);
        var moved = scrollY - s0, dir = Math.abs(v) > 0.3 ? (v > 0 ? 1 : -1) : moved > 40 ? 1 : moved < -40 ? -1 : 0;
        var list = stops(), target = dir > 0 ? list[list.length - 1] : 0, k;
        if (dir > 0) { for (k = 0; k < list.length; k++) if (list[k] > s0 + 8) { target = list[k]; break; } }
        else if (dir < 0) { for (k = list.length - 1; k >= 0; k--) if (list[k] < s0 - 8) { target = list[k]; break; } }
        else { target = list.reduce(function (b, s) { return Math.abs(s - s0) < Math.abs(b - s0) ? s : b; }, list[0]); }
        to(target, v);
      }
      addEventListener('touchend', end, { passive: true });
      addEventListener('touchcancel', end, { passive: true });
      if (cue) cue.addEventListener('click', function (e) { e.preventDefault(); next(); });
      glider = { next: next, stops: stops };
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build); else build();
  })(document.currentScript.previousElementSibling);
</script>
{%- endunless -%}
{% schema %}
{ "name": "Divisions",
  "settings": [
    { "type": "text", "id": "groups", "label": "Divisions", "default": "new-in | shelf-sale | shop-categories + houses | shelf-presale",
      "info": "Parts by id, divisions split by |, parts of one division joined by +." },
    { "type": "range", "id": "hold", "label": "Green division: hold at the top", "min": 20, "max": 120, "step": 10, "unit": "%", "default": 60,
      "info": "How far the page goes on, in screen heights, while the green division holds at the top and deepens to full green." }
  ],
  "presets": [{ "name": "Divisions" }] }
{% endschema %}
