{%- comment -%}
  About us (owner, 2026-11-01): the stall photograph and the owner's About text, laid out like the
  home page's story section. The words are settings here, as they are on the home page, so the
  page's own body in Shopify is not shown. With no photograph chosen it falls back to the stall
  photograph in Files.

  Set up: Online Store → Pages → Add page with the handle "about-us". templates/page.liquid
  shows this section for that handle on any template, and page.about.json does too.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- comment -%} Empty fields use the standard wording in locales (about.*), so every language has it: Translate & Adapt cannot translate a schema default. {%- endcomment -%}
{%- assign std_stamp = 'about.stamp' | t -%}{%- assign std_eyebrow = 'about.eyebrow' | t -%}{%- assign std_heading = 'about.heading' | t -%}{%- assign std_body = 'about.body_html' | t -%}
{%- assign eyebrow = s.eyebrow | default: std_eyebrow -%}
{%- assign img = s.image | default: images['karineko-story-shell-dish.jpg'] -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell story">
    <div class="art">{%- render 'plate', image: img, ratio: 0.80, seed: 5, tone: 'light', comp: 'single', stamp: s.stamp | default: std_stamp -%}</div>
    <div class="txt">
      {%- if eyebrow != blank -%}<p class="eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h1>{{ s.heading | default: std_heading }}</h1>
      <div>{{ s.body | default: std_body }}</div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "About us", "settings": [
  { "type": "image_picker", "id": "image", "label": "Plate" },
  { "type": "text", "id": "stamp", "label": "Stamp", "info": "Leave empty for the standard wording, which is translated into every language. Text here replaces it in English (translate it in Translate & Adapt)." },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave empty for the standard wording, which is translated into every language. Text here replaces it in English (translate it in Translate & Adapt)." },
  { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty for the standard wording, which is translated into every language. Text here replaces it in English (translate it in Translate & Adapt)." },
  { "type": "richtext", "id": "body", "label": "Body", "info": "Leave empty for the standard wording, which is translated into every language. Text here replaces it in English (translate it in Translate & Adapt)." }
] }
{% endschema %}
