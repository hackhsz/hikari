{%- comment -%}
  About us (owner, 2026-11-01): the stall photograph and the owner's About text, laid out like the
  home page's story section. The words are settings here, as they are on the home page, so the
  page's own body in Shopify is not shown. With no photograph chosen it falls back to the stall
  photograph in Files.

  Set up: Online Store → Pages → Add page with the handle "about-us". templates/page.liquid
  shows this section for that handle on any template, and page.about.json does too.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign img = s.image | default: images['karineko-story-shell-dish.jpg'] -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell story">
    <div class="art">{%- render 'plate', image: img, ratio: 0.80, seed: 5, tone: 'light', comp: 'single', stamp: s.stamp -%}</div>
    <div class="txt">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1>{{ s.heading }}</h1>
      <div>{{ s.body }}</div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "About us", "settings": [
  { "type": "image_picker", "id": "image", "label": "Plate" },
  { "type": "text", "id": "stamp", "label": "Stamp", "default": "Plate 05 · At the stall, October" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Karineko" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "The beauty of finding something rare." },
  { "type": "richtext", "id": "body", "label": "Body",
    "default": "<p>Karineko Vintage is an independent vintage boutique dedicated to discovering distinctive pieces from the world of luxury.</p><p>Sourced in person and through carefully selected auctions in Japan, each piece is handpicked for its design, character and timeless appeal.</p><p>Every item is individually inspected for authenticity and condition before being offered. Authenticity is guaranteed.</p><p>Based in London, we believe luxury should be personal, considered and accessible.</p><p><em>A past worth keeping.</em></p>" }
] }
{% endschema %}
