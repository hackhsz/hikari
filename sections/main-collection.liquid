{%- comment -%}
  The catalogue. Each piece carries its brand (Vendor), category (the first of the category tags
  below that it has), status (snippets/status), price and date as data, and the bar over the grid
  filters and sorts them in the page: brand, category, what to show, and the order. The address
  keeps the view (?brand= &cat= &show= &sort_by=), so a filtered view can be linked to; the home
  page shelves link here with ?show=sale or ?show=presale.

  Without JavaScript only Sort shows, and it falls back on Shopify's own ?sort_by=, done by the
  server. This works on the first 50 pieces Shopify lists; past that, move to Shopify's own
  filters (Search & Discovery) and paginate.

  A piece's category is a product tag: earrings, brooches, necklaces, bracelets or rings.
{%- endcomment -%}
{%- assign cat_tags = 'earrings,brooches,necklaces,bracelets,rings' | split: ',' -%}
{%- assign cats_here = '' -%}
{%- for t in cat_tags -%}{%- if collection.all_tags contains t -%}{%- assign cats_here = cats_here | append: t | append: ',' -%}{%- endif -%}{%- endfor -%}
{%- assign cats_here = cats_here | split: ',' -%}
{%- assign sort_now = collection.sort_by | default: collection.default_sort_by -%}
<section class="pad" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell">
    <p class="eyebrow" data-cat-count>{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</p>
    <h1 style="font-family:var(--serif);font-weight:200;font-size:clamp(34px,7vw,64px);line-height:1;margin:0 0 18px">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte" style="max-width:56ch;opacity:.72;margin-bottom:clamp(36px,6vw,56px)">{{ collection.description }}</div>
    {%- endif -%}

    <div class="cat-bar">
      <div class="cat-filters" data-cat-filters hidden>
        <fieldset class="prefs-set">
          <legend>Brand</legend>
          <label class="prefs-chip"><input type="radio" name="cat-brand" value="" checked><span>All</span></label>
          {%- for v in collection.all_vendors -%}
            <label class="prefs-chip"><input type="radio" name="cat-brand" value="{{ v | handleize }}"><span>{{ v }}</span></label>
          {%- endfor -%}
        </fieldset>
        {%- if cats_here.size > 0 -%}
          <fieldset class="prefs-set">
            <legend>Category</legend>
            <label class="prefs-chip"><input type="radio" name="cat-cat" value="" checked><span>All</span></label>
            {%- for t in cats_here -%}
              <label class="prefs-chip"><input type="radio" name="cat-cat" value="{{ t }}"><span>{{ t | capitalize }}</span></label>
            {%- endfor -%}
          </fieldset>
        {%- endif -%}
        <fieldset class="prefs-set">
          <legend>Show</legend>
          <label class="prefs-chip"><input type="radio" name="cat-show" value="" checked><span>Everything</span></label>
          <label class="prefs-chip"><input type="radio" name="cat-show" value="available"><span>Available</span></label>
          <label class="prefs-chip"><input type="radio" name="cat-show" value="sale"><span>On sale</span></label>
          <label class="prefs-chip"><input type="radio" name="cat-show" value="presale"><span>Pre-sale</span></label>
        </fieldset>
      </div>
      <form class="cat-sort" method="get">
        <label for="cat-sort-by">Sort</label>
        <select id="cat-sort-by" name="sort_by" data-cat-sort>
          {%- assign sorts = 'manual:Featured|price-ascending:Price, low to high|price-descending:Price, high to low|created-descending:Newest first|vendor:Brand, A to Z' | split: '|' -%}
          {%- for s in sorts -%}
            {%- assign kv = s | split: ':' -%}
            <option value="{{ kv[0] }}"{% if kv[0] == sort_now %} selected{% endif %}>{{ kv[1] }}</option>
          {%- endfor -%}
        </select>
        <noscript><button type="submit" class="prefs-skip">Sort</button></noscript>
      </form>
    </div>

    <div class="grid4" data-cat-grid>
      {%- for p in collection.products -%}
        {%- capture st -%}{%- render 'status', p: p -%}{%- endcapture -%}
        {%- assign c = '' -%}
        {%- for t in cat_tags -%}{%- if p.tags contains t -%}{%- assign c = t -%}{%- break -%}{%- endif -%}{%- endfor -%}
        <div class="cat-item" data-pos="{{ forloop.index }}" data-brand="{{ p.vendor | handleize }}" data-vendor="{{ p.vendor | escape }}"
             data-cat="{{ c }}" data-status="{{ st }}" data-price="{{ p.price }}" data-date="{{ p.published_at | date: '%s' }}">
          {%- render 'product-card', card_product: p, tone: 'grey' -%}
        </div>
      {%- endfor -%}
    </div>
    <p class="ne-empty cat-empty" data-cat-empty hidden>Nothing matches that. <button type="button" class="prefs-skip" data-cat-reset>Show everything</button></p>
  </div>
</section>
{% schema %}{ "name": "Collection", "settings": [] }{% endschema %}
