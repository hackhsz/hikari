{%- comment -%}
  Shop by category: one square tile per category that has pieces, photographed with a piece from
  it (snippets/pick), with how many pieces it has. A tile goes where the phone menu's shop list
  goes (snippets/shop-nav): the category's collection when one exists, else the catalogue
  filtered to it.

  New in shows the eight newest pieces that are not sold, so a tile looks for a piece outside
  those first; otherwise the same photograph would appear twice on the home page.

  Look (owner, 2026-11-18: no background colour, icons, with a hover animation): "photo" is the tile
  above; "line", "ring" and "chip" show a line icon per category instead (snippets/jewel-icon,
  styles "Shop by category and Shop by brand as line icons" in assets/hikari.css).
{%- endcomment -%}
{%- assign look = section.settings.look | default: 'photo' -%}
{%- assign cat_tags = 'necklaces,earrings,bracelets,rings,brooches,sunglasses' | split: ',' -%}
{%- capture newest -%}{%- render 'newest-handles' -%}{%- endcapture -%}
{%- assign all_url = routes.all_products_collection_url -%}
{%- liquid
  assign g_bg = '#FAF8F3'
  assign g_fg = '#1C1B18'
  if section.settings.ground == 'green'
    assign g_bg = '#2F5B45'
    assign g_fg = '#FAF8F3'
  endif
-%}
<section class="pad-s{% if section.settings.ground == 'green' and section.settings.fade_in %} ground-fade{% endif %}" id="shop-categories" data-bg="{{ g_bg }}" data-fg="{{ g_fg }}" style="--sec-bg:{{ g_bg }};--sec-fg:{{ g_fg }};">
  <div class="shell">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sec-h">{{ section.settings.heading }}</h2>
      </div>
      <a class="sec-all" href="{{ all_url }}">{{ 'home.all_pieces' | t: count: collections.all.products_count }}</a>
    </div>
    <div class="{% if look == 'photo' %}cat-tiles{% else %}icon-tiles icon-tiles--{{ look }}{% endif %}">
      {%- for t in cat_tags -%}
        {%- unless collections.all.all_tags contains t -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign n = 0
          for p in collections.all.products
            if p.tags contains t
              assign n = n | plus: 1
            endif
          endfor
          if look == 'photo'
            capture h
              render 'pick', tag: t, avoid: newest
            endcapture
            assign h = h | strip
            assign pick = all_products[h]
          endif
          assign ch = 'vintage-' | append: t
          assign c = collections[ch]
          if c.handle == ch and c.products_count > 0
            assign u = c.url
          else
            assign u = all_url | append: '?cat=' | append: t
          endif
          assign k = 'collections.categories.' | append: t
        -%}
        {%- if look == 'photo' -%}
        <a class="cat-tile" href="{{ u }}">
          {%- render 'plate', image: pick.featured_image, ratio: 1, fill: true, later: true, sizes: '(max-width: 600px) 50vw, (max-width: 900px) 33vw, 200px', seed: forloop.index, tone: 'light', comp: 'single', alt: '' -%}
          <span class="ct-name">{{ k | t }}</span>
          <span class="ct-n">{{ 'collections.pieces' | t: count: n }}</span>
        </a>
        {%- else -%}
        <a class="icon-tile" href="{{ u }}" style="--n:{{ forloop.index0 }}">
          <span class="ti-ico">{%- render 'jewel-icon', name: t -%}</span>
          <span class="ct-name">{{ k | t }}</span>
          <span class="ct-n">{{ 'collections.pieces' | t: count: n }}</span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Shop by category",
  "settings": [
    { "type": "select", "id": "ground", "label": "Ground", "default": "page",
      "options": [ { "value": "page", "label": "The page colour" }, { "value": "green", "label": "Green, white words and icons" } ],
      "info": "Green from Shop by category to the end of the home page (owner, 2026-11-19)." },
    { "type": "checkbox", "id": "fade_in", "label": "Fade in from the page colour above", "default": true,
      "info": "With a green ground: a long soft band from the colour above into the green." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "select", "id": "look", "label": "Look", "default": "photo",
      "options": [
        { "value": "photo", "label": "A photograph per category" },
        { "value": "line", "label": "Line icons" },
        { "value": "ring", "label": "Line icons in a circle" },
        { "value": "chip", "label": "Small icons in pills" }
      ] }
  ],
  "presets": [{ "name": "Shop by category" }] }
{% endschema %}
