{%- comment -%}
  Shop by category: one square tile per category that has pieces, photographed with a piece from
  it (snippets/pick), with how many pieces it has. A tile goes where the phone menu's shop list
  goes (snippets/shop-nav): the category's collection when one exists, else the catalogue
  filtered to it.

  New in shows the eight newest pieces that are not sold, so a tile looks for a piece outside
  those first; otherwise the same photograph would appear twice on the home page.
{%- endcomment -%}
{%- assign cat_tags = 'necklaces,earrings,bracelets,rings,brooches,sunglasses' | split: ',' -%}
{%- capture newest -%}{%- render 'newest-handles' -%}{%- endcapture -%}
{%- assign all_url = routes.all_products_collection_url -%}
<section class="pad-s" id="shop-categories" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sec-h">{{ section.settings.heading }}</h2>
      </div>
      <a class="sec-all" href="{{ all_url }}">{{ 'home.all_pieces' | t: count: collections.all.products_count }}</a>
    </div>
    <div class="cat-tiles">
      {%- for t in cat_tags -%}
        {%- unless collections.all.all_tags contains t -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign n = 0
          for p in collections.all.products
            if p.tags contains t
              assign n = n | plus: 1
            endif
          endfor
          capture h
            render 'pick', tag: t, avoid: newest
          endcapture
          assign h = h | strip
          assign pick = all_products[h]
          assign ch = 'vintage-' | append: t
          assign c = collections[ch]
          if c.handle == ch and c.products_count > 0
            assign u = c.url
          else
            assign u = all_url | append: '?cat=' | append: t
          endif
          assign k = 'collections.categories.' | append: t
        -%}
        <a class="cat-tile" href="{{ u }}">
          {%- render 'plate', image: pick.featured_image, ratio: 1, fill: true, sizes: '(max-width: 600px) 50vw, (max-width: 900px) 33vw, 200px', seed: forloop.index, tone: 'light', comp: 'single', alt: '' -%}
          <span class="ct-name">{{ k | t }}</span>
          <span class="ct-n">{{ 'collections.pieces' | t: count: n }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "presets": [{ "name": "Shop by category" }] }
{% endschema %}
