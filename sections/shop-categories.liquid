{%- comment -%}
  Shop by category: one square tile per category that has pieces, photographed with a piece from
  it (one still for sale or coming soon, before a sold one), with how many pieces it has. A tile
  goes where the phone menu's shop list goes (snippets/shop-nav): the category's collection when
  one exists, else the catalogue filtered to it.

  New in shows the eight newest pieces that are not sold, so a tile looks for a piece outside
  those first; otherwise the same photograph would appear twice on the home page.
{%- endcomment -%}
{%- assign cat_tags = 'necklaces,earrings,bracelets,rings,brooches,sunglasses' | split: ',' -%}
{%- assign newest = ',' -%}
{%- assign shown = 0 -%}
{%- assign items = collections.all.products | sort: 'published_at' | reverse -%}
{%- for p in items -%}
  {%- if shown >= 8 -%}{%- break -%}{%- endif -%}
  {%- capture st -%}{%- render 'status', p: p -%}{%- endcapture -%}
  {%- if st == 'sold' -%}{%- continue -%}{%- endif -%}
  {%- assign newest = newest | append: p.handle | append: ',' -%}
  {%- assign shown = shown | plus: 1 -%}
{%- endfor -%}
{%- assign all_url = routes.all_products_collection_url -%}
<section class="pad-s" id="shop-categories" data-bg="#FAF8F3" data-fg="#1C1B18" style="--sec-bg:#FAF8F3;--sec-fg:#1C1B18;">
  <div class="shell">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="sec-h">{{ section.settings.heading }}</h2>
      </div>
      <a class="sec-all" href="{{ all_url }}">{{ 'home.all_pieces' | t: count: collections.all.products_count }}</a>
    </div>
    <div class="cat-tiles">
      {%- for t in cat_tags -%}
        {%- unless collections.all.all_tags contains t -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign n = 0
          assign pick = nil
          assign other = nil
          assign spare = nil
          for p in collections.all.products
            if p.tags contains t
              assign n = n | plus: 1
              assign key = ',' | append: p.handle | append: ','
              unless newest contains key
                if pick == nil and p.available or pick == nil and p.tags contains 'coming-soon'
                  assign pick = p
                endif
                if other == nil
                  assign other = p
                endif
              endunless
              if spare == nil
                assign spare = p
              endif
            endif
          endfor
          if pick == nil
            assign pick = other | default: spare
          endif
          assign ch = 'vintage-' | append: t
          assign c = collections[ch]
          if c.handle == ch and c.products_count > 0
            assign u = c.url
          else
            assign u = all_url | append: '?cat=' | append: t
          endif
          assign k = 'collections.categories.' | append: t
        -%}
        <a class="cat-tile" href="{{ u }}">
          {%- render 'plate', image: pick.featured_image, ratio: 1, fill: true, sizes: '(max-width: 600px) 50vw, (max-width: 900px) 33vw, 200px', seed: forloop.index, tone: 'light', comp: 'single', alt: '' -%}
          <span class="ct-name">{{ k | t }}</span>
          <span class="ct-n">{{ 'collections.pieces' | t: count: n }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "presets": [{ "name": "Shop by category" }] }
{% endschema %}
