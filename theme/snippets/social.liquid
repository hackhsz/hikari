{%- comment -%}
  Links to our accounts, from theme settings → Social. An empty setting shows nothing, so the
  handles can wait on the name (#57, #59). In the theme editor the empty ones show as a reminder.
  WeChat opens the QR dialog in snippets/dialogs.
{%- endcomment -%}
{%- capture items -%}
  {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener me">Instagram</a></li>{%- elsif request.design_mode -%}<li class="social-unset">Instagram</li>{%- endif -%}
  {%- if settings.social_xiaohongshu != blank -%}<li><a href="{{ settings.social_xiaohongshu }}" target="_blank" rel="noopener me" lang="zh">小红书</a></li>{%- elsif request.design_mode -%}<li class="social-unset" lang="zh">小红书</li>{%- endif -%}
  {%- if settings.wechat_id != blank or settings.wechat_qr -%}<li><a href="#wechat" data-sheet-open="wechat" aria-controls="wechat" aria-expanded="false">WeChat <span lang="zh">微信</span></a></li>{%- elsif request.design_mode -%}<li class="social-unset">WeChat</li>{%- endif -%}
  {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener me">TikTok</a></li>{%- elsif request.design_mode -%}<li class="social-unset">TikTok</li>{%- endif -%}
  {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener me">Pinterest</a></li>{%- elsif request.design_mode -%}<li class="social-unset">Pinterest</li>{%- endif -%}
{%- endcapture -%}
{%- if items != blank -%}<ul class="social" aria-label="{{ label | default: 'Follow us' }}">{{ items }}</ul>{%- endif -%}
