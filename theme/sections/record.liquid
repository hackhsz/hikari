{%- comment -%}
  The Record: sold pieces stay live. Proof of demand, and an accumulating SEO asset.

  Three sources, in order: a collection chosen in the editor; on a collection page (the house
  template), the sold pieces of that collection; otherwise everything sold. On a house page
  with nothing sold yet the section renders nothing, rather than six empty frames.
{%- endcomment -%}
{%- liquid
  assign on_house = false
  if section.settings.collection != blank
    assign recs = collections[section.settings.collection].products
    assign sold_only = false
  elsif template.name == 'collection' and collection
    assign recs = collection.products
    assign sold_only = true
    assign on_house = true
  else
    assign recs = collections.all.products
    assign sold_only = true
  endif
-%}
{%- capture items -%}
  {%- assign shown = 0 -%}
  {%- for p in recs -%}
    {%- if sold_only and p.available -%}{%- continue -%}{%- endif -%}
    {%- if shown >= 6 -%}{%- break -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    <a class="rec" href="{{ p.url }}">
      {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover' }}{%- endif -%}
      <b>{{ p.vendor | default: p.title | truncate: 14 }} · sold</b>
    </a>
  {%- endfor -%}
{%- endcapture -%}
{%- unless on_house and shown == 0 -%}
<section data-bg="#14171A" data-fg="#EFF0EC" style="--sec-bg:#14171A;--sec-fg:#EFF0EC;">
  <div class="shell pad" id="record">
    <p class="eyebrow">{{ section.settings.heading }}</p>
    <div class="grid6">
      {{ items }}
      {%- if shown == 0 -%}{%- for i in (1..6) -%}<div class="rec"><b>—</b></div>{%- endfor -%}{%- endif -%}
    </div>
  </div>
</section>
{%- endunless -%}
{% schema %}
{ "name": "The Record", "settings": [
  { "type": "text", "id": "heading", "label": "Eyebrow", "default": "The Record — everything that has passed through" },
  { "type": "collection", "id": "collection", "label": "Sold collection" }
], "presets": [{ "name": "The Record" }] }
{% endschema %}
