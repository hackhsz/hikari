<section class="pad" id="recent" data-bg="#1E2E3E" data-fg="#EFF0EC">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.heading }}</p>
    <div class="grid4">
      {%- assign col = collections[section.settings.collection] -%}
      {%- for p in col.products limit: 4 -%}
        {%- render 'product-card', card_product: p, tone: 'dark' -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <a class="card" href="#">{%- render 'plate', ratio: 1.25, seed: i, tone: 'dark', comp: 'single' -%}
          <div class="cinfo"><h3 class="chouse">—</h3></div></a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Recently found", "settings": [
  { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Recently found" },
  { "type": "collection", "id": "collection", "label": "Collection" }
], "presets": [{ "name": "Recently found" }] }
{% endschema %}
