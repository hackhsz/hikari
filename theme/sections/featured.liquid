<section class="pad" data-bg="#E7E8E3" data-fg="#14171A" style="--sec-bg:#E7E8E3;--sec-fg:#14171A;">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.heading }}</p>
    <div class="featured">
      {%- for block in section.blocks limit: 3 -%}
        {%- assign bp = block.settings.product -%}
        {%- unless bp -%}
          {%- comment -%} Fall back to the next pieces in stock, skipping the one in the Alcove. {%- endcomment -%}
          {%- assign want = forloop.index | plus: 1 -%}{%- assign n = 0 -%}
          {%- for cp in collections.all.products -%}
            {%- if cp.available -%}
              {%- assign n = n | plus: 1 -%}
              {%- if n == want -%}{%- assign bp = cp -%}{%- break -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}
        {%- if bp -%}
          {%- render 'product-card', card_product: bp, tone: 'grey' -%}
        {%- else -%}
          <a class="card" href="{{ routes.all_products_collection_url }}">
            {%- render 'plate', ratio: 1.25, seed: forloop.index, tone: 'grey', comp: 'single' -%}
            <div class="cinfo"><h3 class="chouse">—</h3></div></a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "This Edition", "max_blocks": 3,
  "settings": [{ "type": "text", "id": "heading", "label": "Eyebrow", "default": "This Edition — three more" }],
  "blocks": [{ "type": "piece", "name": "Piece", "settings": [{ "type": "product", "id": "product", "label": "Piece" }] }],
  "presets": [{ "name": "This Edition", "blocks": [{"type":"piece"},{"type":"piece"},{"type":"piece"}] }] }
{% endschema %}
