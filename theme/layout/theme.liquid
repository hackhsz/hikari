<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <script>document.documentElement.classList.add("js")</script>
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200;0,6..72,300;0,6..72,400;1,6..72,200;1,6..72,300&family=Instrument+Sans:wght@400;500;600&family=Noto+Serif+JP:wght@200;300;400&display=swap">

  {{ content_for_header }}
  {{ 'hikari.css' | asset_url | stylesheet_tag }}
  <script>
    window.HikariRoutes = {
      cart_url: {{ routes.cart_url | json }},
      cart_add_url: {{ routes.cart_add_url | json }},
      cart_change_url: {{ routes.cart_change_url | json }},
      cart_update_url: {{ routes.cart_update_url | json }}
    };
  </script>
  <script src="{{ 'hikari.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name }}">
  <div id="grain" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>

  {% section 'header' %}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
  {% section 'bag-drawer' %}
  {% section 'signup-popup' %}
  {%- render 'dialogs' -%}
</body>
</html>
