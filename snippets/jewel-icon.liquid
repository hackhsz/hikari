{%- comment -%}
  Line icons for Shop by category and Shop by brand (owner, 2026-11-18: "remove the background colour
  and make those iconised", with a hover animation). One thin line on a 24-unit grid, in the ink of
  the section (currentColor), nothing filled. Every path has pathLength="1", so CSS can draw it in
  (stroke-dashoffset 1 → 0): on hover, on keyboard focus, and once when the row first scrolls in.

  A brand is never shown by its logo (sections/houses: "plain text in our own typeface, no logos").
  The houses get a motif instead: a camellia for Chanel, a lucky star for Dior. Both are generic shapes.

  name: a category tag (necklaces, earrings, bracelets, rings, brooches, sunglasses) or a house name.
{%- endcomment -%}
{%- assign key = name | downcase | handleize -%}
{%- if key contains 'chanel' -%}{%- assign key = 'chanel' -%}{%- elsif key contains 'dior' -%}{%- assign key = 'dior' -%}{%- endif -%}
<svg class="jicon jicon--{{ key }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case key -%}
    {%- when 'necklaces' -%}
      <path pathLength="1" d="M3.5 3.5C4.5 11 8 14.8 12 15C16 14.8 19.5 11 20.5 3.5"/>
      <path pathLength="1" d="M12 15V16.6"/>
      <path pathLength="1" d="M12 16.6C10.4 18.2 10.2 20.2 12 21.2C13.8 20.2 13.6 18.2 12 16.6Z"/>
    {%- when 'earrings' -%}
      <path pathLength="1" d="M7.6 3C9.2 3 9.5 5 7.8 5.6V9.2"/>
      <path pathLength="1" d="M5.2 12.4a2.6 2.6 0 1 0 5.2 0a2.6 2.6 0 1 0 -5.2 0"/>
      <path pathLength="1" d="M16 3C17.6 3 17.9 5 16.2 5.6V9.2"/>
      <path pathLength="1" d="M13.6 12.4a2.6 2.6 0 1 0 5.2 0a2.6 2.6 0 1 0 -5.2 0"/>
    {%- when 'bracelets' -%}
      <path pathLength="1" d="M3 13a9 5.2 0 1 0 18 0a9 5.2 0 1 0 -18 0"/>
      <path pathLength="1" d="M5.4 12.3a6.6 3.3 0 1 0 13.2 0a6.6 3.3 0 1 0 -13.2 0"/>
      <path pathLength="1" d="M12 18.2V19.4"/>
      <path pathLength="1" d="M11 20.4a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
    {%- when 'rings' -%}
      <path pathLength="1" d="M6 15a6 6 0 1 0 12 0a6 6 0 1 0 -12 0"/>
      <path pathLength="1" d="M9.6 7.2L12 4.4L14.4 7.2L12 9.2Z"/>
      <path pathLength="1" d="M9.6 7.2H14.4"/>
    {%- when 'brooches' -%}
      <path pathLength="1" d="M12 11C9.5 8 4.5 6.5 4 9.5C3.6 12.4 8.5 12.8 12 11"/>
      <path pathLength="1" d="M12 11C14.5 8 19.5 6.5 20 9.5C20.4 12.4 15.5 12.8 12 11"/>
      <path pathLength="1" d="M10.7 11a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0"/>
      <path pathLength="1" d="M11.2 12.2L8.6 18.6L9.9 18M12.8 12.2L15.4 18.6L14.1 18"/>
    {%- when 'sunglasses' -%}
      <path pathLength="1" d="M3.2 10H10V12.8C10 15.2 8.6 16.4 6.6 16.4C4.6 16.4 3.2 15.2 3.2 12.8Z"/>
      <path pathLength="1" d="M14 10H20.8V12.8C20.8 15.2 19.4 16.4 17.4 16.4C15.4 16.4 14 15.2 14 12.8Z"/>
      <path pathLength="1" d="M10 11C11 10.2 13 10.2 14 11M3.2 10L1.8 8.6M20.8 10L22.2 8.6"/>
    {%- when 'chanel' -%}
      <path pathLength="1" d="M12 5.4Q16.8 3.69 17.72 8.7Q21.6 12 17.72 15.3Q16.8 20.31 12 18.6Q7.2 20.31 6.28 15.3Q2.4 12 6.28 8.7Q7.2 3.69 12 5.4Z"/>
      <path pathLength="1" d="M13.52 8.41Q17.22 8.85 15.89 12.33Q16.61 16 12.88 15.8Q9.62 17.62 8.66 14.01Q5.92 11.48 9.05 9.45Q10.62 6.06 13.52 8.41Z"/>
      <path pathLength="1" d="M10.6 12a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0 -2.8 0"/>
    {%- when 'dior' -%}
      <path pathLength="1" d="M12 3.4L13.94 9.73L20.56 9.62L15.14 13.42L17.29 19.68L12 15.7L6.71 19.68L8.86 13.42L3.44 9.62L10.06 9.73Z"/>
      <path pathLength="1" d="M19.6 3.2V6M18.2 4.6H21"/>
    {%- else -%}
      <path pathLength="1" d="M6 9L9 5H15L18 9L12 19Z"/>
      <path pathLength="1" d="M6 9H18M9 5L12 9L15 5"/>
  {%- endcase -%}
</svg>
