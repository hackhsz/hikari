{%- comment -%}
  One line in the bag, shared by the drawer and the bag page.
  `item` is a cart line item. data-variant-id lets the script tell what is already in the bag.

  Shopify does not hold stock in a cart (D17), so a piece can sell to someone else while it
  sits in this bag, or be reserved for a client (tagged reserved, snippets/status). The line then
  says so, and bag-foot stops the checkout until it is removed.
  A piece in transit carries its shipping note as a line property, named in the buyer's language
  (or "Pre-sale", the older name); the line repeats the note.
{%- endcomment -%}
{%- assign piece = item.product.metafields.hikari.piece | default: item.product.title -%}
{%- assign held = false -%}{%- if item.product.tags contains 'reserved' -%}{%- assign held = true -%}{%- endif -%}
{%- assign gone = true -%}{%- if item.variant.available and held == false -%}{%- assign gone = false -%}{%- endif -%}
{%- assign transit_label = 'products.badge.pre_sale' | t -%}
{%- assign transit = false -%}
{%- for prop in item.properties -%}
  {%- if prop.first == transit_label or prop.first == 'In transit' or prop.first == 'Pre-sale' -%}{%- if prop.last != blank -%}{%- assign transit = true -%}{%- endif -%}{%- endif -%}
{%- endfor -%}
{%- assign rm_house = item.vendor | default: piece -%}
{%- capture track -%}{%- render 'track-item', p: item.product -%}{%- endcapture -%}
<li class="bag-line{% if gone %} is-sold{% endif %}" data-variant-id="{{ item.variant_id }}" data-track-item="{{ track | strip | escape }}">
  <a class="bag-thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- render 'plate', image: item.image, ratio: 1, fill: true, sizes: '110px', seed: item.product_id, tone: 'grey',
        comp: 'single', alt: piece, width: 240 -%}
  </a>
  <div class="bag-info">
    <a class="bag-house" href="{{ item.url }}">{{ item.vendor | default: item.product.title }}</a>
    <p class="bag-piece">{{ piece }}</p>
    <p class="bag-oneof">{% if held %}{{ 'cart.reserved_since' | t }}{% elsif gone %}{{ 'cart.sold_since' | t }}{% else %}{{ 'products.product.one_of_one' | t }}{% endif %}</p>
    {%- if transit and gone == false -%}<p class="bag-oneof bag-presale">{{ transit_label }}. {{ 'products.product.transit_note' | t: days: settings.transit_days }}</p>{%- endif -%}
    <a class="bag-remove" href="{{ item.url_to_remove }}" data-bag-remove="{{ item.key }}"
       aria-label="{{ 'cart.remove_label' | t: house: rm_house, piece: piece | escape_once }}">{{ 'cart.remove' | t }}</a>
  </div>
  <span class="price bag-price">{% if held %}{{ 'products.badge.reserved' | t }}{% elsif gone %}{{ 'products.product.sold_out' | t }}{% else %}{{ item.final_line_price | money }}{% endif %}</span>
</li>
