{%- comment -%}
  What search engines and link previews read, in <head>: the title, the description, Open Graph
  and Twitter tags for shared links, and structured data (JSON-LD) Google uses for rich results.

  Titles say what a page sells, not only the shop's name:
    home        theme settings → Search → Home page title (else Shopify's title)
    a piece     "Vintage {house} {piece}", unless a search title was set on the product in Shopify
    catalogue   collections.all_title instead of Shopify's "Products"
  Descriptions come from Shopify (Online Store preferences, the product's description, the
  collection's description), with the theme's own line for the home page and the catalogue.

  Structured data: the shop (Organization, WebSite: what it is, London, the houses it deals in) on
  every page; on a piece, Product with its house, photographs, condition (used: it is vintage) and
  what its page lists (era, grade, measurements, mark, provenance), an Offer once it has a price,
  and the path to it (BreadcrumbList); on a collection, the page and its pieces (CollectionPage,
  ItemList); About and Contact as AboutPage and ContactPage; a guide as BlogPosting with its
  breadcrumb, and the guides page as Blog. Search engines and AI assistants
  both read it. A coming-soon or sold piece is OutOfStock: it cannot be bought now.

  Params: brand.
{%- endcomment -%}
{%- liquid
  assign title = page_title | replace: shop.name, brand
  assign desc = page_description
  assign og_type = 'website'
  assign og_image = settings.seo_image
  case template.name
    when 'index'
      if settings.seo_home_title != blank
        assign title = settings.seo_home_title
      endif
      if settings.seo_home_description != blank
        assign desc = settings.seo_home_description
      endif
    when 'product'
      if page_title == product.title and product.vendor != blank
        assign title = 'Vintage ' | append: product.vendor | append: ' ' | append: product.title
      endif
      assign tail = 'products.seo_tail' | t: house: product.vendor
      assign desc = page_description | default: product.title | strip | append: ' ' | append: tail | truncate: 300
      assign og_type = 'product'
      assign og_image = product.featured_image
    when 'collection'
      if collection.handle == 'all'
        assign title = 'collections.all_title' | t
        if collection.description == blank
          assign desc = 'collections.all_intro' | t
        endif
      endif
      if collection.image
        assign og_image = collection.image
      elsif collection.products.first.featured_image
        assign og_image = collection.products.first.featured_image
      endif
    when 'article'
      assign og_type = 'article'
      if article.image
        assign og_image = article.image
      endif
      if desc == blank
        assign desc = article.excerpt_or_content | strip_html | strip | truncate: 300
      endif
    when 'blog'
      if page_title == blog.title
        assign title = 'blog.seo_title' | t
      endif
      if desc == blank
        assign desc = 'blog.lede' | t
      endif
    when 'page'
      if page.handle == 'faq' or page.handle == 'questions'
        assign title = 'guide.title' | t
        assign desc = 'guide.description' | t
      endif
  endcase
  if current_tags
    assign tag_list = current_tags | join: ', '
    assign title = title | append: ' – ' | append: tag_list
  endif
  unless title contains brand
    assign title = title | append: ' · ' | append: brand
  endunless
-%}
<title>{{ title }}</title>
{%- if desc != blank %}
<meta name="description" content="{{ desc | strip_html | strip_newlines | escape }}">
{%- endif %}
{%- if settings.google_verification != blank %}
<meta name="google-site-verification" content="{{ settings.google_verification | escape }}">
{%- endif %}
<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if desc != blank %}
<meta property="og:description" content="{{ desc | strip_html | strip_newlines | escape }}">
{%- endif %}
{%- if og_image %}
<meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
<meta property="og:image:alt" content="{{ og_image.alt | default: title | escape }}">
{%- endif %}
{%- if template.name == 'product' and product.price > 0 %}
<meta property="product:price:amount" content="{{ product.price | money_without_currency | remove: ',' }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">

{%- liquid
  assign same_as = ''
  if settings.social_instagram != blank
    assign same_as = same_as | append: settings.social_instagram | append: '|'
  endif
  if settings.social_xiaohongshu != blank
    assign same_as = same_as | append: settings.social_xiaohongshu | append: '|'
  endif
  if settings.social_pinterest != blank
    assign same_as = same_as | append: settings.social_pinterest | append: '|'
  endif
  assign same_as = same_as | split: '|'
  # Other names (theme settings → Search), e.g. "Karineko", so Google ties them to this site.
  assign alt_names = ''
  assign alt_raw = settings.seo_alternate_name | split: ','
  for a in alt_raw
    assign a = a | strip
    if a != blank
      assign alt_names = alt_names | append: a | append: '|'
    endif
  endfor
  assign alt_names = alt_names | split: '|'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#org' | json }},
      "name": {{ brand | json }},
      {%- if alt_names.size > 0 %}"alternateName": {{ alt_names | json }},{% endif %}
      "url": {{ shop.url | json }}
      {%- if settings.seo_logo %},"logo": {{ settings.seo_logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif -%}
      {%- if same_as.size > 0 %},"sameAs": {{ same_as | json }}{% endif %}
      {%- assign org_desc = settings.seo_home_description | default: shop.description -%}
      {%- if org_desc != blank %},"description": {{ org_desc | strip_html | strip_newlines | strip | json }}{% endif %}
      ,"location": { "@type": "Place", "address": { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" } }
      {%- if shop.vendors.size > 0 %},"knowsAbout": [{% for v in shop.vendors %}{{ 'Vintage ' | append: v | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endif %}
    },
    {
      "@type": "WebSite",
      "@id": {{ shop.url | append: '/#site' | json }},
      "name": {{ brand | json }},
      {%- if alt_names.size > 0 %}"alternateName": {{ alt_names | json }},{% endif %}
      "url": {{ shop.url | json }},
      "publisher": { "@id": {{ shop.url | append: '/#org' | json }} }
    }
    {%- if template.name == 'product' -%}
      {%- liquid
        assign st = ''
        capture st
          render 'status', p: product
        endcapture
        assign availability = 'https://schema.org/OutOfStock'
        if product.available and st != 'soon'
          assign availability = 'https://schema.org/InStock'
        endif
        if st == 'presale'
          assign availability = 'https://schema.org/PreOrder'
        endif
        assign full_name = product.vendor | append: ' ' | append: product.title
        assign cat_tags = 'necklaces,earrings,bracelets,rings,brooches,sunglasses' | split: ','
        assign cat = ''
        for t in cat_tags
          if product.tags contains t
            assign cat = t
            break
          endif
        endfor
      -%}
    ,{
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ full_name | json }},
      "url": {{ canonical_url | json }},
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "description": {{ product.description | strip_html | strip_newlines | strip | default: full_name | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      "itemCondition": "https://schema.org/UsedCondition",
      {%- assign hm = product.metafields.hikari -%}
      {%- capture spec -%}
        {%- if hm.era != blank -%}{"@type":"PropertyValue","name":{{ 'products.spec.era' | t | json }},"value":{{ hm.era.value | append: '' | json }}},{%- endif -%}
        {%- if hm.grade != blank -%}{"@type":"PropertyValue","name":{{ 'products.spec.condition' | t | json }},"value":{{ 'products.spec.grade' | t: grade: hm.grade.value | json }}},{%- endif -%}
        {%- if hm.measurements != blank -%}{"@type":"PropertyValue","name":{{ 'products.spec.measurements' | t | json }},"value":{{ hm.measurements.value | append: '' | json }}},{%- endif -%}
        {%- if hm.mark != blank -%}{"@type":"PropertyValue","name":{{ 'products.spec.mark' | t | json }},"value":{{ hm.mark.value | append: '' | json }}},{%- endif -%}
        {%- if hm.provenance != blank -%}{"@type":"PropertyValue","name":{{ 'products.spec.provenance' | t | json }},"value":{{ hm.provenance.value | append: '' | json }}},{%- endif -%}
      {%- endcapture -%}
      {%- assign spec = spec | strip | remove_last: ',' -%}
      {%- if spec != blank %}"additionalProperty": [{{ spec }}],{% endif %}
      {%- if cat != blank %}"category": {{ 'collections.categories.' | append: cat | t | json }},{% endif %}
      "image": [
        {%- for img in product.images limit: 5 -%}
          {{ img | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
      {%- if product.price > 0 -%}
      ,"offers": {
        "@type": "Offer",
        "url": {{ canonical_url | json }},
        "price": {{ product.price | money_without_currency | remove: ',' | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": {{ availability | json }},
        "itemCondition": "https://schema.org/UsedCondition",
        "seller": { "@id": {{ shop.url | append: '/#org' | json }} }
      }
      {%- endif %}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ brand | json }}, "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ 'collections.all_title' | t | json }}, "item": {{ shop.url | append: routes.all_products_collection_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ full_name | json }}, "item": {{ canonical_url | json }} }
      ]
    }
    {%- endif %}
    {%- comment -%} A collection: the page, and the pieces on it in order (the first 24). {%- endcomment -%}
    {%- if template.name == 'collection' -%}
      {%- assign list_name = collection.title -%}
      {%- if collection.handle == 'all' %}{% assign list_name = 'collections.all_title' | t %}{% endif -%}
    ,{
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#page' | json }},
      "name": {{ list_name | json }},
      "url": {{ canonical_url | json }},
      {%- if desc != blank %}"description": {{ desc | strip_html | strip_newlines | strip | json }},{% endif %}
      "isPartOf": { "@id": {{ shop.url | append: '/#site' | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for p in collection.products limit: 24 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: p.url | json }}, "name": {{ p.vendor | append: ' ' | append: p.title | strip | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
    {%- endif %}
    {%- comment -%} About and Contact say what they are; other pages are plain web pages. {%- endcomment -%}
    {%- if template.name == 'page' -%}
      {%- assign kind = 'WebPage' -%}
      {%- if page.handle == 'about-us' or page.handle == 'about' %}{% assign kind = 'AboutPage' %}{% elsif page.handle == 'contact' %}{% assign kind = 'ContactPage' %}{% endif -%}
    ,{
      "@type": {{ kind | json }},
      "@id": {{ canonical_url | append: '#page' | json }},
      "name": {{ page.title | json }},
      "url": {{ canonical_url | json }},
      "isPartOf": { "@id": {{ shop.url | append: '/#site' | json }} },
      "about": { "@id": {{ shop.url | append: '/#org' | json }} }
    }
    {%- endif %}
    {%- comment -%} A guide: the article, the guides it belongs to, and the path to it. {%- endcomment -%}
    {%- if template.name == 'article' -%}
    ,{
      "@type": "BlogPosting",
      "@id": {{ canonical_url | append: '#article' | json }},
      "headline": {{ article.title | json }},
      {%- if desc != blank %}"description": {{ desc | strip_html | strip_newlines | strip | json }},{% endif %}
      "url": {{ canonical_url | json }},
      "mainEntityOfPage": {{ canonical_url | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
      {%- if article.image %}"image": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},{% endif %}
      {%- if article.tags.size > 0 %}"keywords": {{ article.tags | join: ', ' | json }},{% endif %}
      "author": { "@id": {{ shop.url | append: '/#org' | json }} },
      "publisher": { "@id": {{ shop.url | append: '/#org' | json }} },
      "isPartOf": { "@id": {{ shop.url | append: blog.url | append: '#blog' | json }} }
    },
    {
      "@type": "Blog",
      "@id": {{ shop.url | append: blog.url | append: '#blog' | json }},
      "name": {{ blog.title | json }},
      "url": {{ shop.url | append: blog.url | json }},
      "publisher": { "@id": {{ shop.url | append: '/#org' | json }} }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ brand | json }}, "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
    {%- endif %}
    {%- comment -%} The guides: the blog and its newest posts. {%- endcomment -%}
    {%- if template.name == 'blog' -%}
    ,{
      "@type": "Blog",
      "@id": {{ shop.url | append: blog.url | append: '#blog' | json }},
      "name": {{ blog.title | json }},
      "url": {{ canonical_url | json }},
      {%- if desc != blank %}"description": {{ desc | strip_html | strip_newlines | strip | json }},{% endif %}
      "inLanguage": {{ request.locale.iso_code | json }},
      "publisher": { "@id": {{ shop.url | append: '/#org' | json }} },
      "blogPost": [
        {%- for a in blog.articles limit: 12 -%}
        { "@type": "BlogPosting", "headline": {{ a.title | json }}, "url": {{ shop.url | append: a.url | json }}, "datePublished": {{ a.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
    {%- endif %}
  ]
}
</script>
