{%- comment -%}
  The shop's own way in, built from the catalogue rather than a Shopify menu, so it always
  matches what is there: all pieces, each category that has pieces, each house, and coming soon.

  Each link goes to a collection with the matching handle when one exists and has pieces
  (vintage-necklaces… for a category, vintage-christian-dior-jewellery… for a house as in
  snippets/house-url, coming-soon), else to the catalogue filtered in
  the page (?cat= ?brand= ?show=). Making those collections later moves the links to them, with
  no theme change. The test is on the handle: for a missing handle Shopify still answers
  collections['x'] with an object that has no url but a non-zero count. Used by the header (desktop bar and the phone menu) and the catalogue sidebar.

  Params: cls (class on each link), current (true to mark the link for the page being shown).
  Liquid can only see the path, so a filtered catalogue (?cat=…) is marked by hikari.js
  (markShopNav), which also follows the filters as they change.
{%- endcomment -%}
{%- liquid
  assign cat_tags = 'necklaces,earrings,bracelets,rings,brooches,sunglasses' | split: ','
  assign all_url = routes.all_products_collection_url
  assign soon_n = 0
  for p in collections.all.products
    if p.tags contains 'coming-soon'
      assign soon_n = soon_n | plus: 1
    endif
  endfor
-%}
<a class="{{ cls }}" href="{{ all_url }}"{% if current and request.path == all_url %} aria-current="page"{% endif %}>{{ 'layout.shop_nav.all' | t }}</a>
{%- for t in cat_tags -%}
  {%- if collections.all.all_tags contains t -%}
    {%- assign ch = 'vintage-' | append: t -%}
    {%- assign c = collections[ch] -%}
    {%- if c.handle == ch and c.products_count > 0 -%}{%- assign u = c.url -%}{%- else -%}{%- assign u = all_url | append: '?cat=' | append: t -%}{%- endif -%}
    {%- assign k = 'collections.categories.' | append: t -%}
    <a class="{{ cls }}" href="{{ u }}"{% if current and request.path == u %} aria-current="page"{% endif %}>{{ k | t }}</a>
  {%- endif -%}
{%- endfor -%}
{%- for v in collections.all.all_vendors -%}
  {%- assign h = v | handleize -%}
  {%- assign ch = 'vintage-' | append: h | append: '-jewellery' -%}
  {%- assign c = collections[ch] -%}
  {%- if c.handle == ch and c.products_count > 0 -%}{%- assign u = c.url -%}{%- else -%}{%- assign u = all_url | append: '?brand=' | append: h -%}{%- endif -%}
  <a class="{{ cls }} {{ cls }}--house" href="{{ u }}"{% if current and request.path == u %} aria-current="page"{% endif %}>{{ v }}</a>
{%- endfor -%}
{%- if soon_n > 0 -%}
  {%- assign c = collections['coming-soon'] -%}
  {%- if c.handle == 'coming-soon' and c.products_count > 0 -%}{%- assign u = c.url -%}{%- else -%}{%- assign u = all_url | append: '?show=soon' -%}{%- endif -%}
  <a class="{{ cls }} {{ cls }}--soon" href="{{ u }}"{% if current and request.path == u %} aria-current="page"{% endif %}>{{ 'products.badge.coming_soon' | t }}</a>
{%- endif -%}
