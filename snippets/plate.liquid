{%- comment -%}
  A plate: the real photograph where one exists, a drawn daylight study where it does not,
  so the store is presentable before photography exists. See 2-photos/13-photography-pipeline.md.
  Grain applies to frames 1 and 3 only — the maker's-mark macro and the condition frame
  are evidence and stay unretouched (D6, D10).
  fill: the frame keeps the ratio (height / width) whatever the photograph's shape, and the photograph
  is cropped to it around its focal point (set on the image in Shopify: Edit image > Focal point),
  so cards in a row are all the same size. sizes: the image's display width, for the srcset.
  contain (with fill): the whole photograph is shown, uncropped, in the frame, over a blurred copy
  of itself instead of an empty mat. For one large picture, where a crop could cut the piece.
{%- endcomment -%}
{%- assign r = ratio | default: 0.8 -%}
{%- assign w = width | default: 1400 -%}
<div class="plate{% if fill %} plate--fill{% endif %}{% if contain %} plate--contain{% endif %}"{% if fill %} style="aspect-ratio:1 / {{ r }}"{% endif %}>
  {%- if image and fill -%}
    {%- liquid
      assign focal = image.presentation.focal_point | default: '50% 50%'
      assign obj_style = 'object-position: ' | append: focal
      assign img_sizes = sizes | default: '100vw'
      assign img_alt = alt | default: ''
    -%}
    {%- comment -%} Arguments are plain variables: a filter inside an argument list (alt: alt | default: '')
        ends image_tag there, and every argument after it is dropped. {%- endcomment -%}
    {%- if contain -%}{{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'plate-bg', aria-hidden: 'true', widths: '240', sizes: '240px' }}{%- endif -%}
    {{ image | image_url: width: w | image_tag: loading: 'lazy', alt: img_alt, sizes: img_sizes, style: obj_style }}
  {%- elsif image -%}
    {{ image | image_url: width: w | image_tag: loading: 'lazy', alt: alt | default: '' }}
  {%- else -%}
    <canvas data-seed="{{ seed | default: 1 }}" data-tone="{{ tone | default: 'light' }}"{% if fill %} data-fill="1"{% endif %}
            data-comp="{{ comp | default: 'pair' }}" data-ratio="{{ r }}" role="img"
            aria-label="{% if alt != blank %}{{ alt | escape }}{% else %}{{ 'general.photography_to_follow' | t }}{% endif %}"></canvas>
  {%- endif -%}
  {%- if stamp %}<span class="stamp">{{ stamp }}</span>{% endif -%}
  {%- comment -%} badge: a word from snippets/status (D25). Sold is ink, the rest green. {%- endcomment -%}
  {%- case badge -%}
    {%- when 'soon' %}<span class="badge badge--soon">{{ 'products.badge.coming_soon' | t }}</span>
    {%- when 'presale' %}<span class="badge badge--soon">{{ 'products.badge.pre_sale' | t }}</span>
    {%- when 'sale' %}<span class="badge badge--new">{{ 'products.badge.sale' | t }}</span>
    {%- when 'new' %}<span class="badge badge--new">{{ 'products.badge.new' | t }}</span>
    {%- when 'sold' %}<span class="badge badge--sold">{{ 'products.product.sold_out' | t }}</span>
  {%- endcase -%}
</div>
