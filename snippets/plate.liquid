{%- comment -%}
  A plate: the real photograph where one exists, a drawn daylight study where it does not,
  so the store is presentable before photography exists. See 2-photos/13-photography-pipeline.md.
  Grain applies to frames 1 and 3 only — the maker's-mark macro and the condition frame
  are evidence and stay unretouched (D6, D10).
  fill: the frame keeps the ratio (height / width) whatever the photograph's shape, and the photograph
  is cropped to it around its focal point (set on the image in Shopify: Edit image > Focal point),
  so cards in a row are all the same size. sizes: the image's display width, for the srcset.
  contain (with fill): the whole photograph is shown, uncropped, in the frame, over a blurred copy
  of itself instead of an empty mat. For one large picture, where a crop could cut the piece.
  mark (with no image): the shop's cat drawing and "Photography to follow" instead of the drawn
  study, for a piece whose own photograph is not taken yet (snippets/product-card).
  first: the photograph is the page's largest thing (the first photograph of a piece), so it loads at
  once and before the rest, not lazily: how fast that appears is what Google times (LCP).
  The srcset steps every 120 to 270px up to the width, so a phone gets a photograph near the size it
  shows (Shopify's own steps went 352 → 832: a 190px tile on a phone downloaded 832px, 2026-11-04).
  later: below the first screen, the photograph waits for the page's first one (assets/hikari.js,
  initLater): on a phone on 4G the home page's tiles shared the line with the banner and held it
  back to 5.2s, 3.0s without them. A blank stands in, in a frame that already has its size, so
  nothing moves; without the script the <noscript> copy shows.
{%- endcomment -%}
{%- assign r = ratio | default: 0.8 -%}
{%- assign w = width | default: 1400 -%}
{%- liquid
  assign steps = '360, 480, 640, 832, 1100, 1400'
  if w > 1400
    assign steps = steps | append: ', ' | append: w
  endif
  assign load = 'lazy'
  assign priority = 'auto'
  if first
    assign load = 'eager'
    assign priority = 'high'
  endif
-%}
<div class="plate{% if fill %} plate--fill{% endif %}{% if contain %} plate--contain{% endif %}"{% if fill %} style="aspect-ratio:1 / {{ r }}"{% endif %}>
  {%- if image and fill -%}
    {%- liquid
      assign focal = image.presentation.focal_point | default: '50% 50%'
      assign obj_style = 'object-position: ' | append: focal
      assign img_sizes = sizes | default: '100vw'
      assign img_alt = alt | default: ''
    -%}
    {%- comment -%} Arguments are plain variables: a filter inside an argument list (alt: alt | default: '')
        ends image_tag there, and every argument after it is silently dropped. {%- endcomment -%}
    {%- if contain -%}{{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'plate-bg', aria-hidden: 'true', widths: '240', sizes: '240px' }}{%- endif -%}
    {%- capture tag -%}{{ image | image_url: width: w | image_tag: loading: load, fetchpriority: priority, widths: steps, alt: img_alt, sizes: img_sizes, style: obj_style }}{%- endcapture -%}
    {%- if later -%}
      {{ tag | replace: ' src="', ' src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-later-src="' | replace: ' srcset="', ' data-later-srcset="' }}<noscript>{{ tag }}</noscript>
    {%- else -%}
      {{ tag }}
    {%- endif -%}
  {%- elsif image -%}
    {%- assign img_alt = alt | default: '' -%}{%- assign img_sizes = sizes | default: '(max-width: 860px) 100vw, 58vw' -%}
    {{ image | image_url: width: w | image_tag: loading: load, fetchpriority: priority, widths: steps, sizes: img_sizes, alt: img_alt }}
  {%- elsif mark -%}
    <div class="plate-mark" role="img" aria-label="{{ 'general.photography_to_follow' | t }}">
      <span class="pm-cat" style="--mark:url({{ 'brand-mark.png' | asset_url }})" aria-hidden="true"></span>
      <span class="pm-t" aria-hidden="true">{{ 'general.photography_to_follow' | t }}</span>
    </div>
  {%- else -%}
    <canvas data-seed="{{ seed | default: 1 }}" data-tone="{{ tone | default: 'light' }}"{% if fill %} data-fill="1"{% endif %}
            data-comp="{{ comp | default: 'pair' }}" data-ratio="{{ r }}" role="img"
            aria-label="{% if alt != blank %}{{ alt | escape }}{% else %}{{ 'general.photography_to_follow' | t }}{% endif %}"></canvas>
  {%- endif -%}
  {%- if stamp %}<span class="stamp">{{ stamp }}</span>{% endif -%}
  {%- comment -%} badge: a word from snippets/status (D25). Sold and Reserved are ink, the rest green. {%- endcomment -%}
  {%- case badge -%}
    {%- when 'soon' %}<span class="badge badge--soon">{{ 'products.badge.coming_soon' | t }}</span>
    {%- when 'presale' %}<span class="badge badge--soon">{{ 'products.badge.pre_sale' | t }}</span>
    {%- when 'sale' %}<span class="badge badge--new">{{ 'products.badge.sale' | t }}</span>
    {%- when 'new' %}<span class="badge badge--new">{{ 'products.badge.new' | t }}</span>
    {%- when 'sold' %}<span class="badge badge--sold">{{ 'products.product.sold_out' | t }}</span>
    {%- when 'reserved' %}<span class="badge badge--sold">{{ 'products.badge.reserved' | t }}</span>
  {%- endcase -%}
</div>
