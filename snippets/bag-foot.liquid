{%- comment -%}
  Total, checkout and the trust block, shared by the drawer and the bag page.
  `ctx` is 'drawer' or 'page': the cart page renders both, so ids need telling apart.

  1-shop/04-site-ia.md: the payment step is the last and most fragile moment of the trust
  architecture, so the trust block repeats here and the accepted payment marks are visible.
  D12: all-in pricing, so the total is the price paid. No fee or tax line, ever. Delivery gets
  its own line so that stays true: free from settings.delivery_free_pieces pieces, and only below
  that does the total become a subtotal (1-shop/21-checkout.md), with a line saying how many more
  pieces make delivery free. Free delivery is for the UK only: a buyer in any other country always
  sees delivery added at checkout. Checkout gets the same rule from the automatic discount
  "Complimentary UK delivery on two or more pieces" (minimum quantity of items), 2026-11-10.

  A piece that has sold (or been reserved for a client) since it was added is left out of the
  total, and checkout waits until it is removed. Shopify would otherwise drop it on its own stock-problem screen, which is
  a worse way to find out.

  The gift fields belong to the checkout form (the form attribute), so they reach the order as
  cart attributes with or without JavaScript. The script also saves them as they change, because the drawer
  re-renders on every add and remove.

  In the drawer, .bag-pay (total and Checkout) stays pinned to the bottom while the pieces
  scroll, and .bag-more follows the list, so a phone still shows the pieces.
{%- endcomment -%}
{%- liquid
  assign ctx = ctx | default: 'drawer'
  assign live_total = 0
  assign live_n = 0
  assign live_qty = 0
  assign sold_n = 0
  assign held_n = 0
  for item in cart.items
    assign held = false
    if item.product.tags contains 'reserved'
      assign held = true
    endif
    if item.variant.available and held == false
      assign live_total = live_total | plus: item.final_line_price
      assign live_n = live_n | plus: 1
      assign live_qty = live_qty | plus: item.quantity
    else
      assign sold_n = sold_n | plus: 1
      if held
        assign held_n = held_n | plus: 1
      endif
    endif
  endfor
  # When every piece that can't be bought is reserved rather than sold, the warning says reserved.
  assign why = 'sold'
  if held_n > 0 and held_n == sold_n
    assign why = 'reserved'
  endif
  assign free_from = settings.delivery_free_pieces | default: 0
  assign free_more = free_from | minus: live_qty
  assign in_uk = false
  if localization.country.iso_code == 'GB'
    assign in_uk = true
  endif
  assign delivery_free = false
  if in_uk and live_qty >= free_from
    assign delivery_free = true
  endif
  assign is_gift = false
  if cart.attributes['Gift'] == 'Yes'
    assign is_gift = true
  endif
-%}
<div class="bag-foot">
  {%- comment -%} Before the pinned total, so it scrolls with the pieces; form= ties it to checkout. {%- endcomment -%}
  {%- if settings.gift_enabled and live_n > 0 -%}
    {%- assign f = 'bag-checkout-' | append: ctx -%}
    <div class="bag-gift" data-bag-gift>
      <input type="hidden" name="attributes[Gift]" value="" form="{{ f }}">
      <label class="bag-check">
        <input type="checkbox" name="attributes[Gift]" value="Yes" form="{{ f }}" data-gift-toggle
               aria-controls="gift-{{ ctx }}"{% if is_gift %} checked{% endif %}>
        <span>{{ settings.gift_label }}</span>
      </label>
      <div class="bag-gift-note" id="gift-{{ ctx }}"{% unless is_gift %} hidden{% endunless %}>
        <label class="bag-label" for="gift-note-{{ ctx }}">{{ 'cart.gift_note' | t }}</label>
        <textarea id="gift-note-{{ ctx }}" name="attributes[Gift note]" form="{{ f }}" rows="3" maxlength="240"
                  data-gift-note{% unless is_gift %} disabled{% endunless %}>{{ cart.attributes['Gift note'] }}</textarea>
        {%- if settings.gift_info != blank -%}<p class="bag-fine">{{ settings.gift_info }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="bag-pay">
    {%- if live_n == 0 -%}
      <p class="bag-warn">
        {%- if sold_n == 1 -%}{{ 'cart.all_' | append: why | append: '_single' | t }}{%- else -%}{{ 'cart.all_' | append: why | append: '_several' | t }}{%- endif -%}
      </p>
      <p class="bag-again"><a class="bag-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.see_every_piece' | t }}</a></p>
    {%- else -%}
    {%- if settings.bag_notice != blank -%}<p class="bag-notice">{{ settings.bag_notice }}</p>{%- endif -%}
    <div class="bag-row">
      <span class="bag-label">{% if in_uk %}{{ 'cart.delivery' | t }}{% else %}{{ 'cart.delivery_abroad' | t }}{% endif %}</span>
      <span>{% if delivery_free %}{{ 'cart.free' | t }}{% else %}{{ 'cart.added_at_checkout' | t }}{% endif %}</span>
    </div>
    {%- if in_uk and delivery_free == false and free_more > 0 -%}
      <p class="bag-fine bag-free-more">{{ 'cart.free_more' | t: count: free_more }}</p>
    {%- endif -%}
    <div class="bag-total">
      <span class="bag-label">{% if delivery_free %}{{ 'cart.total' | t }}{% else %}{{ 'cart.subtotal' | t }}{% endif %}</span>
      <span class="price bag-sum">{{ live_total | money }}</span>
    </div>
    {%- if settings.vat_line != blank -%}<p class="bag-fine">{{ settings.vat_line }}</p>{%- endif -%}
    {%- if sold_n > 0 -%}
      <p class="bag-warn">
        {%- if sold_n == 1 -%}{{ 'cart.some_' | append: why | append: '_single' | t }}
        {%- else -%}{{ 'cart.some_' | append: why | append: '_several' | t }}{%- endif -%}
      </p>
    {%- endif -%}
    <form action="{{ routes.cart_url }}" method="post" class="bag-checkout" id="bag-checkout-{{ ctx }}">
      <button type="submit" name="checkout" class="btn"{% if sold_n > 0 %} disabled{% endif %}>{{ 'cart.checkout' | t }}</button>
    </form>
    {%- endif -%}
  </div>

  <div class="bag-more">
    <p class="bag-fine">{{ 'cart.not_held' | t }}</p>

    {%- if additional_checkout_buttons and sold_n == 0 -%}
      <div class="bag-express additional-checkout-buttons--vertical">{{ content_for_additional_checkout_buttons }}</div>
    {%- endif -%}

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="pay" role="list" aria-label="{{ 'cart.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <ul class="trust-list bag-trust" role="list">
      {%- if settings.trust_1 != blank %}<li>{{ settings.trust_1 }}</li>{% endif -%}
      {%- if settings.trust_2 != blank %}<li>{{ settings.trust_2 }}</li>{% endif -%}
      {%- if settings.trust_3 != blank %}<li>{{ settings.trust_3 }}</li>{% endif -%}
      {%- if settings.trust_4 != blank %}<li>{{ settings.trust_4 }}</li>{% endif -%}
    </ul>
  </div>
</div>
